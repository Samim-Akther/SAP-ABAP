*---------------------------------------------------------------------*
* Form DISPLAY_KNA1_ALV
*---------------------------------------------------------------------*
FORM display_kna1_alv.

  gs_layout_kna1-zebra      = abap_true.
  gs_layout_kna1-cwidth_opt = abap_true.
  gs_layout_kna1-grid_title = 'Customer Header Data - KNA1'.

  CALL METHOD kna1_grid->set_table_for_first_display
    EXPORTING
      is_layout       = gs_layout_kna1
      i_save          = 'A'
    CHANGING
      it_outtab       = gt_kna1
      it_fieldcatalog = gt_fcat_kna1.

ENDFORM.

*---------------------------------------------------------------------*
* Form DISPLAY_VBAK_ALV
*---------------------------------------------------------------------*
FORM display_vbak_alv.

  gs_layout_vbak-zebra      = abap_true.
  gs_layout_vbak-cwidth_opt = abap_true.
  gs_layout_vbak-grid_title = 'Sales Order Data - VBAK'.

  CALL METHOD vbak_grid->set_table_for_first_display
    EXPORTING
      is_layout       = gs_layout_vbak
      i_save          = 'A'
    CHANGING
      it_outtab       = gt_vbak
      it_fieldcatalog = gt_fcat_vbak.

ENDFORM.

*---------------------------------------------------------------------*
* Form FREE_OBJECTS
*---------------------------------------------------------------------*
FORM free_objects.

  IF kna1_grid IS BOUND.
    CALL METHOD kna1_grid->free.
    CLEAR kna1_grid.
  ENDIF.

  IF vbak_grid IS BOUND.
    CALL METHOD vbak_grid->free.
    CLEAR vbak_grid.
  ENDIF.

  IF o_split IS BOUND.
    CALL METHOD o_split->free.
    CLEAR o_split.
  ENDIF.

  IF cust_cont IS BOUND.
    CALL METHOD cust_cont->free.
    CLEAR cust_cont.
  ENDIF.

  CALL METHOD cl_gui_cfw=>flush.

ENDFORM.
