  METHOD generate_attachment.
    DATA: lv_size  TYPE i,
          lv_info  TYPE string,
          lt_solix TYPE solix_tab.

    CONSTANTS lc_pdf TYPE so_obj_tp VALUE 'PDF'.

    CLEAR: ev_size, rs_attach.

    " 1) Generate SOLIX + size (reuse the same hub method)
    DATA(lv_ok) = me->try_generate_pdf_tline(
                    EXPORTING iv_docnum       = iv_docnum
                              iv_doc_category = iv_doc_category
                              iv_key          = iv_key
                    IMPORTING et_solix        = lt_solix
                              ev_size         = lv_size
                              ev_msg          = lv_info ).

    IF lv_ok <> abap_true OR lt_solix IS INITIAL OR lv_size <= 0.
      RETURN.
    ENDIF.

    " 2) Subject = FSD file name (no path)
    DATA(lv_filename) = me->build_filename(
                          iv_doc_category = iv_doc_category
                          iv_docnum      = iv_docnum ).

    rs_attach-type    = lc_pdf.
    rs_attach-subject = lv_filename.
    rs_attach-content = lt_solix.
    ev_size           = lv_size.

  ENDMETHOD.


  METHOD download_single_pdf.

    DATA: lt_solix TYPE solix_tab,
          lv_size  TYPE i,
          lv_info  TYPE string,
          lv_name  TYPE string,
          lv_full  TYPE string.

    CONSTANTS lc_bin  TYPE char10 VALUE 'BIN'.
    rv_ok = abap_false.

    IF iv_folder IS INITIAL.
      RETURN.
    ENDIF.

    DATA(lv_ok) = me->try_generate_pdf_tline(
        EXPORTING iv_docnum       = iv_docnum
                  iv_doc_category = iv_doc_category
                  iv_key          = iv_key
        IMPORTING et_solix        = lt_solix
                  ev_size         = lv_size
                  ev_msg          = lv_info ).


    IF lv_ok <> abap_true OR lt_solix IS INITIAL OR lv_size <= 0.
      RETURN.
    ENDIF.

    " 3) Build FSD filename and full path
    lv_name = me->build_filename(
                iv_doc_category = iv_doc_category
                iv_docnum      = iv_docnum ).
    lv_full = me->build_fullpath(
                iv_dir  = iv_folder
                iv_name = lv_name ).

    " 4) Write the binary (TLINE -> BIN) once

    cl_gui_frontend_services=>gui_download(
        EXPORTING
          filename     = lv_full
          filetype     = lc_bin
          bin_filesize = lv_size
        CHANGING
          data_tab     = lt_solix

    EXCEPTIONS
    file_write_error          = 1
    no_batch                  = 2
    gui_refuse_filetransfer   = 3
    invalid_type              = 4
    no_authority              = 5
    unknown_error             = 6
    header_not_allowed        = 7
    separator_not_allowed     = 8
    filesize_not_allowed      = 9
    header_too_long           = 10
    dp_error_create           = 11
    dp_error_send             = 12
    dp_error_write            = 13
    unknown_dp_error          = 14
    access_denied             = 15
    dp_out_of_memory          = 16
    disk_full                 = 17
    dp_timeout                = 18
    file_not_found            = 19
    dataprovider_exception    = 20
    control_flush_error       = 21
    not_supported_by_gui      = 22
    error_no_gui              = 23
    OTHERS                    = 24
       ) .
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE gc_i   NUMBER sy-msgno DISPLAY LIKE gc_e
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4  .
      RETURN.
    ELSE.
      rv_ok = abap_true.
    ENDIF.
  ENDMETHOD.

  METHOD can_download_any.
    DATA(lv_yes) = abap_false.

    " --- Deliveries (GI-dependent: Delivery Note / Packing List;) ---
    IF lv_yes = abap_false AND gt_view_delivery IS NOT INITIAL.
      LOOP AT gt_view_delivery ASSIGNING FIELD-SYMBOL(<d>).
        IF cb_dlvnt = abap_true AND
           me->gi_block_if_needed( iv_cat = gc_cat_dlvn iv_id = <d>-vbeln ) = abap_false.
          lv_yes = abap_true.
          EXIT.
        ENDIF.
        IF lv_yes = abap_false AND cb_pklst = abap_true AND
           me->gi_block_if_needed( iv_cat = gc_cat_pklst iv_id = <d>-vbeln ) = abap_false.
          lv_yes = abap_true.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

    " --- Shipments (GI-independent: Shipment Request / Loading List) ---
    IF lv_yes = abap_false AND gt_view_shipment IS NOT INITIAL.
      IF cb_shprq = abap_true OR cb_ldlst = abap_true OR cb_cmr = abap_true.
        lv_yes = abap_true.
      ENDIF.
    ENDIF.

    " --- Sales Invoice (GI-dependent via linked deliveries) ---
    IF lv_yes = abap_false AND cb_sinv = abap_true AND gt_view_invoice IS NOT INITIAL.
      LOOP AT gt_view_invoice ASSIGNING FIELD-SYMBOL(<i>).
        IF me->gi_block_if_needed( iv_cat = gc_cat_sinv iv_id = <i>-vbeln ) = abap_false.
          lv_yes = abap_true. EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

    " --- Proforma (GI-dependent via linked deliveries) ---
    IF lv_yes = abap_false AND cb_prfin = abap_true AND gt_view_proforma IS NOT INITIAL.
      LOOP AT gt_view_proforma ASSIGNING FIELD-SYMBOL(<p>).
        IF me->gi_block_if_needed( iv_cat = gc_cat_prfin iv_id = <p>-vbeln ) = abap_false.
          lv_yes = abap_true.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.

    rv_can = lv_yes.
  ENDMETHOD.
  METHOD get_deliveries_without_gi.

    DATA lt_no_gi TYPE STANDARD TABLE OF string.

    CLEAR et_no_gi.

    IF it_delivery IS INITIAL.
      RETURN.
    ENDIF.

    LOOP AT it_delivery ASSIGNING FIELD-SYMBOL(<fs_del>).

      IF me->gi_block_if_needed(
           iv_cat = gc_cat_dlvn
           iv_id  = <fs_del>-vbeln ) = abap_true.

        APPEND me->normalize_id( <fs_del>-vbeln ) TO lt_no_gi.
      ENDIF.

    ENDLOOP.

    SORT lt_no_gi.
    DELETE ADJACENT DUPLICATES FROM lt_no_gi.

    et_no_gi = lt_no_gi.

  ENDMETHOD.


  METHOD process_download.
    DATA :lv_dlvn_msg   TYPE string,
          lt_dlvn_no_gi TYPE ty_string_tab.
    CLEAR: lv_dlvn_msg,lt_dlvn_no_gi.

    IF me->can_download_any( ) <> abap_true.
      MESSAGE s056(zs_mtc_sd) DISPLAY LIKE gc_e.
      RETURN.
    ENDIF.
    IF ( cb_dlvnt = abap_true OR cb_pklst = abap_true )" OR cb_cmr = abap_true )
        AND gt_view_delivery IS NOT INITIAL.
      me->preload_mkpf_for_deliveries( EXPORTING it_delivery = gt_view_delivery ).
    ENDIF.

    IF ( cb_sinv = abap_true OR cb_prfin = abap_true )
         AND gt_view_invoice  IS NOT INITIAL.
      me->preload_bkpf_for_billings( EXPORTING it_billing  = gt_view_invoice  ).
    ENDIF.

    DATA(lv_base_dir) = p_dlpath.
    CONDENSE lv_base_dir.
    IF lv_base_dir IS INITIAL.
      MESSAGE s059(zs_mtc_sd) DISPLAY LIKE gc_e.
      RETURN.
    ENDIF.

    IF gt_view_delivery IS NOT INITIAL.
      me->get_deliveries_without_gi(
        EXPORTING
          it_delivery = gt_view_delivery
        IMPORTING
          et_no_gi    = lt_dlvn_no_gi ).


      LOOP AT gt_view_delivery ASSIGNING FIELD-SYMBOL(<fs_del>).
        IF line_exists( lt_dlvn_no_gi[ table_line = me->normalize_id( <fs_del>-vbeln ) ] ).
          CONTINUE.
        ENDIF.

        IF cb_dlvnt = abap_true.
          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_del>-vbeln
                      iv_doc_category = gc_cat_dlvn
                      iv_key          = |{ gc_cat_dlvn }{ gc_sep }{ p_vkorg }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_dn) ).


        ENDIF.

        IF cb_pklst = abap_true.
          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_del>-vbeln
                      iv_doc_category = gc_cat_pklst
                      iv_key          = |{ gc_cat_pklst }{ gc_sep }{ p_vkorg }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_pl) ).


        ENDIF.

        """""""""""""""""""""""cmr is not defined yet""""""""""""""""""""
        """""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
      ENDLOOP.
    ENDIF.

    " 5. Shipment Request

    IF gt_view_shipment IS NOT INITIAL.

      LOOP AT gt_view_shipment ASSIGNING FIELD-SYMBOL(<fs_shp>).
        IF cb_shprq = abap_true.
          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_shp>-tknum
                      iv_doc_category = gc_cat_shprq
                      iv_key          = |{ gc_cat_shprq }{ gc_sep }{ p_tplst }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_sr) ).
        ENDIF.
        IF cb_ldlst = abap_true.
          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_shp>-tknum
                      iv_doc_category = gc_cat_ldlst
                      iv_key          = |{ gc_cat_ldlst }{ gc_sep }{ p_tplst }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_ll) ).
        ENDIF.
        IF cb_cmr = abap_true.
          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_shp>-tknum
                      iv_doc_category = gc_cat_cmr
                      iv_key          = |{ gc_cat_cmr }{ gc_sep }{ p_vkorg }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_cm) ).
        ENDIF.
      ENDLOOP.
      UNASSIGN <fs_shp>.
    ENDIF.


    " 7. Sales Invoice
    IF cb_sinv = abap_true AND gt_view_invoice IS NOT INITIAL.

      LOOP AT gt_view_invoice ASSIGNING FIELD-SYMBOL(<fs_inv>).

        IF me->gi_block_if_needed(
                            iv_cat = gc_cat_sinv
                            iv_id  = <fs_inv>-vbeln ) = abap_false.

          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_inv>-vbeln
                      iv_doc_category = gc_cat_sinv
                      iv_key          = |{ gc_cat_billdoc }{ gc_sep }{ p_vkorg }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_si) ).

        ENDIF.
      ENDLOOP.
      UNASSIGN <fs_inv>.
    ENDIF.


    " 8. Proforma Invoice

    IF cb_prfin = abap_true AND gt_view_proforma IS NOT INITIAL.
      LOOP AT gt_view_proforma ASSIGNING FIELD-SYMBOL(<fs_prf>).

        IF me->gi_block_if_needed(
                           iv_cat = gc_cat_prfin
                           iv_id  = <fs_prf>-vbeln ) = abap_false.

          me->download_single_pdf(
            EXPORTING iv_docnum       = <fs_prf>-vbeln
                      iv_doc_category = gc_cat_prfin
                      iv_key          = |{ gc_cat_prfin }{ gc_sep }{ p_vkorg }|
                      iv_folder       = lv_base_dir
            RECEIVING rv_ok           = DATA(l_ok_pf) ).
        ENDIF.
      ENDLOOP.
      UNASSIGN <fs_prf>.
    ENDIF.
    """"""""""""""""To show the message that for which deliveries GI is not done""""""""""""""
    IF ( cb_dlvnt = abap_true
       OR cb_pklst = abap_true
       OR cb_cmr   = abap_true
       OR cb_sinv  = abap_true
       OR cb_prfin = abap_true )
       AND lt_dlvn_no_gi IS NOT INITIAL.


      SORT lt_dlvn_no_gi.
      DELETE ADJACENT DUPLICATES FROM lt_dlvn_no_gi.

      CONCATENATE LINES OF lt_dlvn_no_gi
        INTO lv_dlvn_msg
        SEPARATED BY ', '.

      DATA(lv_textline1) = |{ text-014 } { lv_dlvn_msg } { text-015 }|.

      CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
        EXPORTING
          titel        = text-013
          textline1    = lv_textline1
          textline2    = text-016
          start_column = 25
          start_row    = 12.

      CLEAR:lv_textline1.
    ENDIF.
  ENDMETHOD.



  "-----------------------------
  " SO10: read standard text
  "-----------------------------

  METHOD get_so10_text.
    DATA: lt_lines TYPE STANDARD TABLE OF tline.

    CONSTANTS: lc_text TYPE thead-tdobject VALUE 'TEXT',
               lc_st   TYPE thead-tdid VALUE 'ST'.
    CLEAR et_text.

    CALL FUNCTION 'READ_TEXT'
      EXPORTING
        id                      = lc_st
        language                = sy-langu
        name                    = iv_name
        object                  = lc_text
      TABLES
        lines                   = lt_lines
      EXCEPTIONS
        id                      = 1
        language                = 2
        name                    = 3
        not_found               = 4
        object                  = 5
        reference_check         = 6
        wrong_access_to_archive = 7
        OTHERS                  = 8.
    IF sy-subrc <> 0.
      CLEAR lt_lines.
    ENDIF.


    " Convert TLINE -> bcsy_text (SOLI)
    LOOP AT lt_lines ASSIGNING FIELD-SYMBOL(<l>).
      APPEND <l>-tdline TO et_text.
    ENDLOOP.
  ENDMETHOD.

  "-----------------------------
  " Join bcsy_text into a string
  "-----------------------------

  METHOD bcsy_to_string.
    LOOP AT it_text ASSIGNING FIELD-SYMBOL(<t>).
      IF rv_string IS INITIAL.
        rv_string = <t>-line.
      ELSE.
        rv_string = |{ rv_string } { <t>-line }|.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  "---------------------------------------------
  " Convert select-options to ';' separated CSV
  "---------------------------------------------
  METHOD csv_from_sels.

    DATA:lv TYPE string.

    LOOP AT it_sels ASSIGNING FIELD-SYMBOL(<s>).
      IF lv IS INITIAL.
        lv = <s>-low.
      ELSE.
        lv = lv && ';' && <s>-low.
      ENDIF.
    ENDLOOP.
    rv_csv = lv.
    CLEAR lv.
  ENDMETHOD.

  "=============================================
  " EMAIL: direct send now; preview later
  "=============================================
  METHOD process_email.
    DATA: lv_sname TYPE tdobname,
          lv_bname TYPE tdobname.

    IF it_group IS INITIAL.
      MESSAGE s056(zs_mtc_sd)  DISPLAY LIKE gc_e.
      RETURN.
    ENDIF.


    DATA: lt_dlvn_no_gi TYPE ty_string_tab,
          lv_dlvn_msg   TYPE string.


    IF gt_view_delivery IS NOT INITIAL
    AND ( cb_dlvnt = abap_true
       OR cb_pklst = abap_true
       OR cb_cmr   = abap_true
       OR cb_sinv  = abap_true
       OR cb_prfin = abap_true ).

      me->get_deliveries_without_gi(
        EXPORTING
          it_delivery = gt_view_delivery
        IMPORTING
          et_no_gi    = lt_dlvn_no_gi ).

      IF lt_dlvn_no_gi IS NOT INITIAL.
        SORT lt_dlvn_no_gi.
        DELETE ADJACENT DUPLICATES FROM lt_dlvn_no_gi.

        CONCATENATE LINES OF lt_dlvn_no_gi
          INTO lv_dlvn_msg
          SEPARATED BY ', '.

        DATA(lv_textline1) = |{ text-014 } { lv_dlvn_msg } { text-015 }|.

        CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
          EXPORTING
            titel     = text-013
            textline1 = lv_textline1
            textline2 = text-016.
      ENDIF.
    ENDIF.

    " --- PREVIEW PATH ---
    IF p_prev = abap_true.

      me->fill_alv_documents( it_group = gt_group ).


      IF gt_alv IS INITIAL.
        MESSAGE i057(zs_mtc_sd).
        RETURN.
      ENDIF.

      me->display_alv( ).
      RETURN.
    ENDIF.

    " --- DIRECT SEND PATH (p_prev is initial) ---

    IF ( cb_dlvnt = abap_true OR cb_pklst = abap_true )" OR cb_cmr = abap_true )
            AND gt_view_delivery IS NOT INITIAL.
      me->preload_mkpf_for_deliveries( EXPORTING it_delivery = gt_view_delivery ).
    ENDIF.
    IF ( cb_sinv = abap_true OR cb_prfin = abap_true )
         AND gt_view_invoice  IS NOT INITIAL.
      me->preload_bkpf_for_billings( EXPORTING it_billing  = gt_view_invoice  ).
    ENDIF.
    DATA lt_attach  TYPE zattachement_tt.
    DATA ls_att  TYPE zattachement.
    DATA lv_ign     TYPE i.
    DATA: lv_subject1 TYPE so_obj_des.



    DATA lt_body TYPE bcsy_text.
    DATA lt_obj  TYPE bcsy_text.

    CLEAR: lv_sname, lv_bname.

    lo_main->get_text_name( EXPORTING iv_type = gc_sub "++@@Added by Ragni Chandrawanshi on 03Mar2026
                             IMPORTING ev_name = lv_sname )."++@@Added by Ragni Chandrawanshi on 27Feb2026
    lo_main->get_text_name( EXPORTING iv_type = gc_body "++@@Added by Ragni Chandrawanshi on 03Mar2026
                            IMPORTING ev_name = lv_bname )."++@@Added by Ragni Chandrawanshi on 03Mar2026
    me->get_so10_text( EXPORTING iv_name = lv_bname "'ZMAILOUTBODY' "++@@Added by Ragni Chandrawanshi on 03Mar2026
                       IMPORTING et_text = lt_body ).
    me->get_so10_text( EXPORTING iv_name = lv_sname "'ZMAILOUTOBJ' "++@@Modified by Ragni Chandrawanshi on 27Feb2026
                       IMPORTING et_text = lt_obj  ).
    DATA lv_subject_base TYPE so_obj_des.
    lv_subject_base = me->bcsy_to_string( lt_obj ).
    lv_subject1 = lv_subject_base.

    LOOP AT it_group INTO DATA(ls_row)
          GROUP BY ( group = ls_row-group )
          ASCENDING
          ASSIGNING FIELD-SYMBOL(<grp>).
      DATA(lv_grp_txt) = COND string( WHEN <grp>-group IS INITIAL THEN `N/A` ELSE <grp>-group ).

      CLEAR lt_attach.

      LOOP AT GROUP <grp> ASSIGNING FIELD-SYMBOL(<gdoc>).

        CASE <gdoc>-doc_typ.

          WHEN c_deliv.
            IF cb_dlvnt = abap_true.
              CLEAR :ls_att, lv_ign.
              ls_att = me->generate_attachment(
                           EXPORTING iv_docnum       = <gdoc>-doc_no
                                     iv_doc_category = gc_cat_dlvn
                                     iv_key          = |{ gc_cat_dlvn }{ gc_sep }{ p_vkorg }|
                           IMPORTING ev_size         = lv_ign ).
              IF ls_att-content IS NOT INITIAL AND lv_ign > 0.
                APPEND ls_att TO lt_attach.
              ENDIF.

            ENDIF.
            IF cb_pklst = abap_true.
              CLEAR:ls_att,lv_ign.

              ls_att = me->generate_attachment(
                          EXPORTING iv_docnum       = <gdoc>-doc_no
                                    iv_doc_category = gc_cat_pklst
                                    iv_key          = |{ gc_cat_pklst }{ gc_sep }{ p_vkorg }|
                          IMPORTING ev_size         = lv_ign ).
              IF ls_att-content IS NOT INITIAL AND lv_ign > 0.
                APPEND ls_att TO lt_attach.
              ENDIF.

            ENDIF.

            """"""""""""""""""cmr is not defined"""""""""""""'
            """"""""""""""""""""""""""""""""""""""""""""""""""""
          WHEN c_ship.
            IF cb_shprq = abap_true.
              CLEAR:ls_att,lv_ign.
              ls_att = me->generate_attachment(
                           EXPORTING iv_docnum       = <gdoc>-doc_no
                                     iv_doc_category = gc_cat_shprq
                                     iv_key          = |{ gc_cat_shprq }{ gc_sep }{ p_tplst }|
                           IMPORTING ev_size         = lv_ign ).
              IF ls_att-content IS NOT INITIAL AND lv_ign > 0.
                APPEND ls_att TO lt_attach.
              ENDIF.
            ENDIF.

            IF cb_ldlst = abap_true.
              CLEAR:ls_att,lv_ign.

              ls_att = me->generate_attachment(
                           EXPORTING iv_docnum       = <gdoc>-doc_no
                                     iv_doc_category = gc_cat_ldlst
                                     iv_key          = |{ gc_cat_ldlst }{ gc_sep }{ p_tplst }|
                           IMPORTING ev_size         = lv_ign ).
              IF ls_att-content IS NOT INITIAL AND lv_ign > 0.
                APPEND ls_att TO lt_attach.
              ENDIF.

            ENDIF.

          WHEN c_sinv.
            IF cb_sinv = abap_true.
              CLEAR:ls_att,lv_ign.

              ls_att = me->generate_attachment(
                           EXPORTING iv_docnum       = <gdoc>-doc_no
                                     iv_doc_category = gc_cat_sinv
                                     iv_key          = |{ gc_cat_billdoc }{ gc_sep }{ p_vkorg }|
                           IMPORTING ev_size         = lv_ign ).
              IF ls_att-content IS NOT INITIAL AND lv_ign > 0.
                APPEND ls_att TO lt_attach.
              ENDIF.

            ENDIF.

          WHEN c_pro.
            IF cb_prfin = abap_true.
              CLEAR:ls_att,lv_ign.
              ls_att = me->generate_attachment(
                           EXPORTING iv_docnum       = <gdoc>-doc_no
                                     iv_doc_category = gc_cat_prfin
                                     iv_key          = |{ gc_cat_prfin }{ gc_sep }{ p_vkorg }|
                           IMPORTING ev_size         = lv_ign ).
              IF ls_att-content IS NOT INITIAL AND lv_ign > 0.
                APPEND ls_att TO lt_attach.
              ENDIF.
            ENDIF.
        ENDCASE.
      ENDLOOP.

      IF lt_attach IS INITIAL.
        MESSAGE s062(zs_mtc_sd) DISPLAY LIKE gc_e .
        CONTINUE.
      ENDIF.

      DATA(lo_email) = NEW zcl_email_sender( ).
      DATA(lv_ok) = lo_email->send_email(
        iv_subject        = lv_subject1
*        iv_long_subject   = lv_subject
        it_body           = lt_body
        iv_sender         = p_sender
        iv_recipients     = me->csv_from_sels( s_rcv[] )
        iv_cc             = me->csv_from_sels( s_cc[] )
        iv_doc_type       = 'RAW'
        iv_delimiter      = ';'
        iv_attachment_type = 'PDF'
        it_attachments    = lt_attach ).


      IF lv_ok = abap_true.
        MESSAGE s064(zs_mtc_sd).
      ELSE.
        MESSAGE i063(zs_mtc_sd) DISPLAY LIKE gc_e WITH lv_grp_txt .
        CONTINUE.
      ENDIF.

    ENDLOOP.

  ENDMETHOD.

  METHOD normalize_id.

    DATA lv_raw TYPE char40.
    DATA lv_out TYPE char40.

    lv_raw = CONV char40( iv_any ).

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        input  = lv_raw
      IMPORTING
        output = lv_out
      EXCEPTIONS
        OTHERS = 1.

    IF sy-subrc <> 0.
      lv_out = lv_raw.  " fallback
    ENDIF.

    SHIFT lv_out LEFT DELETING LEADING space.
    rv_txt = lv_out.

  ENDMETHOD.

