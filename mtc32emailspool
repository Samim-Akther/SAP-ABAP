  METHOD get_text_name.
    DATA: lv_name TYPE zxysvarv-name.
    CONSTANTS: lc_sub_name  TYPE tdobname VALUE 'ZMAILOUTOBJ',
               lc_body_name TYPE tdobname VALUE 'ZMAILOUTBODY',
               lc_sub       TYPE zxysvarv-name VALUE 'OBJECT_TEXT_',
               lc_body      TYPE zxysvarv-name VALUE 'BODY_TEXT_'.

    IF iv_type EQ gc_sub.
      lv_name = lc_sub && p_vkorg.
      ev_name = lc_sub_name.
    ELSEIF iv_type EQ gc_body.
      lv_name = lc_body && p_vkorg.
      ev_name = lc_body_name.
    ENDIF.
*If entry found from below FM, then EV_NAME will set with that value
*else, it will be default value assigned above
    CALL FUNCTION 'ZXUN_GET_PARAMETER_YSVARV'
      EXPORTING
        i_progname      = gc_progname
        i_name          = lv_name
      IMPORTING
        p_result        = ev_name
      EXCEPTIONS
        wrong_type      = 1
        wrong_value     = 2
        inchoerent_type = 3
        OTHERS          = 4.

    IF sy-subrc IS NOT INITIAL.
      CLEAR ev_name.
    ENDIF.
  ENDMETHOD.
