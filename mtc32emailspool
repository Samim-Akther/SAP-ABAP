  METHOD fill_alv_documents.

    DATA get_group_num TYPE i.
    CLEAR gt_alv.

    IF ( cb_dlvnt = abap_true OR cb_pklst = abap_true )" OR cb_cmr = abap_true )
     AND gt_view_delivery IS NOT INITIAL.
      me->preload_mkpf_for_deliveries( EXPORTING it_delivery = gt_view_delivery ).
    ENDIF.

    IF ( cb_sinv = abap_true OR cb_prfin = abap_true )
     AND gt_view_invoice IS NOT INITIAL.
      me->preload_bkpf_for_billings( EXPORTING it_billing  = gt_view_invoice ).
    ENDIF.


    IF gt_view_shipment IS NOT INITIAL AND
       ( cb_shprq = abap_true OR cb_ldlst = abap_true OR cb_cmr = abap_true ).

      DATA(lv_key_sr) = |{ gc_cat_shprq }{ gc_sep }{ p_tplst }|.
      DATA(lv_key_ll) = |{ gc_cat_ldlst }{ gc_sep }{ p_tplst }|.
      DATA(lv_key_cm) = |{ gc_cat_cmr }{ gc_sep }{ p_vkorg }|.

      LOOP AT gt_view_shipment ASSIGNING FIELD-SYMBOL(<shp>).
        CLEAR get_group_num.
        ASSIGN gt_group[ doc_typ = c_ship
                   doc_no  = <shp>-tknum  ]
         TO FIELD-SYMBOL(<g>).

        IF <g> IS ASSIGNED.
          get_group_num = <g>-group.
          UNASSIGN <g>.
        ENDIF.
        IF get_group_num = 0.
          CONTINUE.
        ENDIF.

        IF cb_shprq = abap_true.

          READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_sr>) WITH KEY doc_key = lv_key_sr BINARY SEARCH.
          IF  <fs_map_sr> IS ASSIGNED AND <fs_map_sr>-output_type IS NOT INITIAL.
            CLEAR gs_alv.
            gs_alv-check_box = gc_x.
            gs_alv-document  = me->build_filename(
                                 iv_doc_category = gc_cat_shprq
                                 iv_docnum       = <shp>-tknum ).
            gs_alv-group     = |{ text-011 }{ get_group_num }|. ""text-011 = Group

            gs_alv-doc_cat   = gc_cat_shprq.
            gs_alv-doc_id    = |{  <shp>-tknum  ALPHA = IN }|.
            APPEND gs_alv TO gt_alv.
            UNASSIGN <fs_map_sr>.
          ENDIF.
        ENDIF.

        IF cb_ldlst = abap_true.
          READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_ll>) WITH KEY doc_key = lv_key_ll BINARY SEARCH.
          IF  <fs_map_ll> IS ASSIGNED AND <fs_map_ll>-output_type IS NOT INITIAL.
            CLEAR gs_alv.
            gs_alv-check_box = gc_x.
            gs_alv-document  = me->build_filename(
                                 iv_doc_category = gc_cat_ldlst
                                 iv_docnum       = <shp>-tknum ).
            gs_alv-group     = |{ text-011 }{ get_group_num }|.
            gs_alv-doc_cat   = gc_cat_ldlst.
            gs_alv-doc_id    = |{  <shp>-tknum ALPHA = IN }|.
            APPEND gs_alv TO gt_alv.
            UNASSIGN <fs_map_ll>.
          ENDIF.
        ENDIF.

        IF cb_cmr = abap_true.
          READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_cm>) WITH KEY doc_key = lv_key_cm BINARY SEARCH.
          IF  <fs_map_cm> IS ASSIGNED AND <fs_map_cm>-output_type IS NOT INITIAL.
            CLEAR gs_alv.
            gs_alv-check_box = gc_x.
            gs_alv-document  = me->build_filename(
                                 iv_doc_category = gc_cat_cmr
                                 iv_docnum       = <shp>-tknum ).
            gs_alv-group     = |{ text-011 }{ get_group_num }|.
            gs_alv-doc_cat   = gc_cat_cmr.
            gs_alv-doc_id    = |{  <shp>-tknum ALPHA = IN }|.
            APPEND gs_alv TO gt_alv.
            UNASSIGN <fs_map_cm>.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.
    IF <shp> IS ASSIGNED.
      UNASSIGN <shp>.
    ENDIF.


    IF gt_view_delivery IS NOT INITIAL AND
       ( cb_dlvnt = abap_true OR cb_pklst = abap_true ).

      DATA(lv_key_dn) = |{ gc_cat_dlvn }{ gc_sep }{ p_vkorg }|.
      DATA(lv_key_pl) = |{ gc_cat_pklst }{ gc_sep }{ p_vkorg }|.


      LOOP AT gt_view_delivery ASSIGNING FIELD-SYMBOL(<del>).
        CLEAR get_group_num.
        ASSIGN gt_group[ doc_typ = c_deliv
                         doc_no  = <del>-vbeln  ] TO <g>.
        IF <g> IS ASSIGNED.
          get_group_num = <g>-group.
          UNASSIGN <g>.
        ENDIF.
        IF get_group_num = 0.
          CONTINUE.
        ENDIF.

        IF cb_dlvnt = abap_true AND
           me->gi_block_if_needed( iv_cat = gc_cat_dlvn
                                   iv_id  = <del>-vbeln ) = abap_false.
          READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_dn>) WITH KEY doc_key = lv_key_dn BINARY SEARCH.
          IF <fs_map_dn> IS ASSIGNED AND <fs_map_dn>-output_type IS NOT INITIAL.


            CLEAR gs_alv.
            gs_alv-check_box = gc_x.
            gs_alv-document  = me->build_filename(
                                 iv_doc_category = gc_cat_dlvn
                                 iv_docnum       = <del>-vbeln ).
            gs_alv-group     = |{ text-011 }{ get_group_num }|.
            gs_alv-doc_cat   = gc_cat_dlvn.
            gs_alv-doc_id    = |{ <del>-vbeln ALPHA = IN }|.
            APPEND gs_alv TO gt_alv.
            UNASSIGN <fs_map_dn>.
          ENDIF.
        ENDIF.


        IF cb_pklst = abap_true AND
           me->gi_block_if_needed( iv_cat = gc_cat_pklst
                                   iv_id  = <del>-vbeln ) = abap_false.
          READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_pl>) WITH KEY doc_key = lv_key_pl
           BINARY SEARCH.

          IF <fs_map_pl> IS ASSIGNED AND <fs_map_pl>-output_type IS NOT INITIAL.

            CLEAR gs_alv.
            gs_alv-check_box = gc_x.
            gs_alv-document  = me->build_filename(
                                 iv_doc_category = gc_cat_pklst
                                 iv_docnum       = <del>-vbeln ).
            gs_alv-group     = |{ text-011 }{ get_group_num }|.
            gs_alv-doc_cat   = gc_cat_pklst.
            gs_alv-doc_id    = |{  <del>-vbeln ALPHA = IN }|.
            APPEND gs_alv TO gt_alv.
            UNASSIGN <fs_map_pl>.
          ENDIF.
        ENDIF.

        """"""""""""""""""""""""""""cmr is not defined""""""""""""""""""""""

        """"""""""""""""""""""""""""""""cmr"""""""""""""""""""""""""""""""""""
      ENDLOOP.
    ENDIF.
    IF <shp> IS ASSIGNED.
      UNASSIGN <shp>.
    ENDIF.

    IF ( gt_view_invoice  IS NOT INITIAL OR gt_view_proforma IS NOT INITIAL ) AND
       ( cb_sinv = abap_true OR cb_prfin = abap_true ).


      IF cb_sinv = abap_true AND gt_view_invoice IS NOT INITIAL.
        DATA(lv_key_si) = |{ gc_cat_billdoc }{ gc_sep }{ p_vkorg }|.
        LOOP AT gt_view_invoice ASSIGNING FIELD-SYMBOL(<inv>).
          CLEAR get_group_num.
          ASSIGN gt_group[ doc_typ = c_sinv
                           doc_no  =  <inv>-vbeln  ] TO <g>.
          IF <g> IS ASSIGNED.
            get_group_num = <g>-group.
            UNASSIGN <g>.
          ENDIF.
          IF get_group_num = 0.
            CONTINUE.
          ENDIF.
          IF me->gi_block_if_needed( iv_cat = gc_cat_sinv
                                     iv_id  = <inv>-vbeln ) = abap_false.
            READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_si>) WITH KEY doc_key = lv_key_si BINARY SEARCH.
            IF <fs_map_si> IS ASSIGNED AND  <fs_map_si>-output_type IS NOT INITIAL.
              CLEAR gs_alv.
              gs_alv-check_box = gc_x.
              gs_alv-document  = me->build_filename(
                                   iv_doc_category = gc_cat_sinv
                                   iv_docnum       = <inv>-vbeln ).
              gs_alv-group     = |{ text-011 }{ get_group_num }|.

              gs_alv-doc_cat   = gc_cat_sinv.
              gs_alv-doc_id    = |{  <inv>-vbeln ALPHA = IN }|.

              APPEND gs_alv TO gt_alv.
              UNASSIGN <fs_map_si>.
            ENDIF.
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF <inv> IS ASSIGNED.
        UNASSIGN <inv>.
      ENDIF.
      IF cb_prfin = abap_true AND gt_view_proforma IS NOT INITIAL.
        DATA(lv_key_pf) = |{ gc_cat_prfin }{ gc_sep }{ p_vkorg }|.
        LOOP AT gt_view_proforma ASSIGNING FIELD-SYMBOL(<prf>).
          CLEAR get_group_num.
          ASSIGN gt_group[ doc_typ = c_pro
                           doc_no  =  <prf>-vbeln  ] TO <g>.
          IF <g> IS ASSIGNED.
            get_group_num = <g>-group.
            UNASSIGN <g>.
          ENDIF.
          IF get_group_num = 0.
            CONTINUE.
          ENDIF.


          IF me->gi_block_if_needed( iv_cat = gc_cat_prfin
                                     iv_id  = <prf>-vbeln ) = abap_false.

            READ TABLE gt_doc_output_types ASSIGNING FIELD-SYMBOL(<fs_map_pf>) WITH KEY doc_key = lv_key_pf BINARY SEARCH.
            IF  <fs_map_pf> IS ASSIGNED AND <fs_map_pf>-output_type IS NOT INITIAL.


              CLEAR gs_alv.
              gs_alv-check_box = gc_x.
              gs_alv-document  = me->build_filename(
                                   iv_doc_category = gc_cat_prfin
                                   iv_docnum       = <prf>-vbeln ).
              gs_alv-group     = |{ text-011 }{ get_group_num }|.

              gs_alv-doc_cat   = gc_cat_prfin.
              gs_alv-doc_id    = | { <prf>-vbeln  ALPHA = IN }|.
              APPEND gs_alv TO gt_alv.
              UNASSIGN <fs_map_pf>.
            ENDIF.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.

    IF <prf> IS ASSIGNED.
      UNASSIGN <prf>.
    ENDIF.

    SORT gt_alv BY group document.
  ENDMETHOD.
