  " Preload BKPF cache once (FOR ALL ENTRIES) for billing names
  "===========================================================

  METHOD preload_bkpf_for_billings.
    CLEAR gt_bkpf_by_awkey.
    IF it_billing IS INITIAL.
      RETURN.
    ENDIF.
    TYPES: BEGIN OF ty_awkey,
             awkey TYPE awkey,
           END OF ty_awkey.

    DATA: lt_awkey_keys TYPE TABLE OF ty_awkey.
    CONSTANTS lc_awtyp TYPE awtyp VALUE 'VBRK'.


    lt_awkey_keys = VALUE #( FOR b IN it_billing ( |{ b-vbeln ALPHA = IN }| ) ).
    SORT lt_awkey_keys.
    DELETE ADJACENT DUPLICATES FROM lt_awkey_keys.

    SELECT bukrs, belnr, gjahr , awkey
      FROM bkpf
      INTO  TABLE @gt_bkpf_by_awkey
      FOR ALL ENTRIES IN @lt_awkey_keys
      WHERE awtyp = @lc_awtyp
        AND awkey = @lt_awkey_keys-awkey.
    IF sy-subrc = 0.
      SORT gt_bkpf_by_awkey BY awkey.
      DELETE ADJACENT DUPLICATES FROM gt_bkpf_by_awkey COMPARING awkey.
    ELSE.
      RETURN.
    ENDIF.
  ENDMETHOD.


  METHOD get_billto_name.
    CLEAR rv_name.

    SELECT SINGLE vbeln, kunrg
      FROM vbrk
      INTO @DATA(ls_kunrg)
      WHERE vbeln = @iv_vbrk.

    IF sy-subrc <> 0.
      RETURN.
    ENDIF.


    DATA(lv_kunrg) = ls_kunrg-kunrg.
    SELECT SINGLE kunnr, name1
      FROM kna1
      INTO @DATA(ls_name1)
      WHERE kunnr = @lv_kunrg.
    IF sy-subrc = 0 .
      DATA(lv_name1) = ls_name1-name1.
    ENDIF.
    IF lv_name1 IS NOT INITIAL.
      rv_name = lv_name1.
    ENDIF.
  ENDMETHOD.

  METHOD build_filename.
    DATA: lv_name  TYPE string,
          lv_vbeln TYPE likp-vbeln,
          lv_mblnr TYPE mkpf-mblnr,
          lv_vbrk  TYPE vbrk-vbeln,
          lv_belnr TYPE bkpf-belnr,
          lv_tknum TYPE vttk-tknum.

    CONSTANTS lc_pdf TYPE string VALUE '.pdf'.

    CASE iv_doc_category.

      WHEN gc_cat_dlvn.
        lv_vbeln = CONV mkpf-xblnr( iv_docnum ).
        IF rb_dlvn1 = abap_true.   " Delivery number
          lv_name = |{ text-017 }_{ lv_vbeln ALPHA = OUT }|. " text-017 - Delivery note
        ELSE.                      " Delivery note number via MKPF-MBLNR
          READ TABLE gt_mkpf_by_xblnr INTO DATA(ls_mkpf)
               WITH KEY xblnr = lv_vbeln.
          IF sy-subrc = 0 AND ls_mkpf-mblnr IS NOT INITIAL.
            lv_mblnr = ls_mkpf-mblnr.
            lv_name  = |{ text-017 }_{ lv_mblnr ALPHA = OUT }|. " text-017 - Delivery note
          ELSE.
            lv_name = |{ text-017 }_{ lv_vbeln ALPHA = OUT }|. " text-017 - Delivery note
          ENDIF.
        ENDIF.

      WHEN gc_cat_pklst.
        lv_vbeln = CONV mkpf-xblnr( iv_docnum ).
        IF rb_pkls1 = abap_true.   " Delivery number
          lv_name = |{ text-018 }_{ lv_vbeln ALPHA = OUT }|. "" text-018 - Packaging list
        ELSE.                      " Delivery note number via MKPF-MBLNR
          READ TABLE gt_mkpf_by_xblnr INTO DATA(ls_mkpf2)
               WITH KEY xblnr = lv_vbeln.
          IF sy-subrc = 0 AND ls_mkpf2-mblnr IS NOT INITIAL.
            lv_mblnr = ls_mkpf2-mblnr.
            lv_name  = |{ text-018 }_{ lv_mblnr ALPHA = OUT }|. "" text-018 - Packaging list
          ELSE.
            lv_name  = |{ text-018 }_{ lv_vbeln ALPHA = OUT }|. "" text-018 - Packaging list
          ENDIF.
        ENDIF.
        """""""""""cmr is not defined yet""""""""""""""""
        """""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
      WHEN gc_cat_sinv.

        lv_vbrk = CONV bkpf-awkey( iv_docnum ).
        READ TABLE gt_bkpf_by_awkey INTO DATA(ls_bkpf)
             WITH KEY awkey = lv_vbrk.
        IF sy-subrc = 0.
          lv_belnr = ls_bkpf-belnr.
        ENDIF.

        IF rb_sinv4 = abap_true.
          DATA(lv_billto) = me->get_billto_name( iv_vbrk = lv_vbrk ).

          " Fallbacks: keep name and trailing token non-empty
          IF lv_billto IS INITIAL.
            lv_billto = |{ lv_vbrk ALPHA = OUT }|.
          ENDIF.
          IF lv_belnr IS INITIAL.
            lv_belnr = lv_vbrk.
          ENDIF.

          lv_name = |{ lv_billto }_{ lv_belnr ALPHA = OUT }|.

        ELSEIF cb_sivnp = abap_true.           " without prefix
          lv_name = COND string(
                      WHEN lv_belnr IS NOT INITIAL THEN |{ lv_belnr ALPHA = OUT }|
                      ELSE |{ lv_vbrk  ALPHA = OUT }| ).
        ELSEIF rb_sinv1 = abap_true.       " Billing document
          lv_name = |{ text-019 }_{ lv_vbrk ALPHA = OUT }|.     " text-019 - Billing document
        ELSE.                               " Accounting document (default)
          lv_name = COND string(
                      WHEN lv_belnr IS NOT INITIAL
                        THEN |{ text-020 }_{ lv_belnr ALPHA = OUT }| " text-020 - Accounting document
                        ELSE |{ text-019 }_{ lv_vbrk  ALPHA = OUT }| ).
        ENDIF.

      WHEN gc_cat_prfin.
        lv_vbrk = CONV vbrk-vbeln( iv_docnum ).
        IF cb_sivnp = abap_true.
          lv_name = |{ lv_vbrk ALPHA = OUT }|.
        ELSE.
          lv_name = |{ text-021 }_{ lv_vbrk ALPHA = OUT }|.  " text-021 - Proforma invoice
        ENDIF.

      WHEN gc_cat_cmr.
        lv_tknum = CONV vttk-tknum( iv_docnum ).
        lv_name  = |{ text-025 }_{ lv_tknum ALPHA = OUT }|. " text-025 - CMR

      WHEN gc_cat_shprq.
        lv_tknum = CONV vttk-tknum( iv_docnum ).
        lv_name  = |{ text-022 }_{ lv_tknum ALPHA = OUT }|. " text-022 - Shipment request

      WHEN gc_cat_ldlst.
        lv_tknum = CONV vttk-tknum( iv_docnum ).
        lv_name  = |{ text-023 }_{ lv_tknum ALPHA = OUT }|.  " text-023 - Loading list

      WHEN OTHERS.
        lv_name = |{ iv_doc_category }_{ iv_docnum }|.
    ENDCASE.

    rv_name = |{ lv_name }{ lc_pdf }|.
    CONDENSE rv_name.
  ENDMETHOD.

  METHOD is_gi_required.
    " Shipment Request & Loading List do NOT require GI.
    rv_yes = xsdbool(
               iv_cat = gc_cat_dlvn OR
               iv_cat = gc_cat_pklst OR
               iv_cat = gc_cat_cmr  OR
               iv_cat = gc_cat_sinv OR
               iv_cat = gc_cat_prfin ).
  ENDMETHOD.

  METHOD gi_block_if_needed.
    rv_block = abap_false.
    CHECK is_gi_required( iv_cat ) = abap_true.


    CASE iv_cat.
      WHEN gc_cat_dlvn OR gc_cat_pklst .
        " iv_id = Delivery number
        DATA(lv_del) = CONV likp-vbeln( iv_id ).
**BOI by Ragni Chandrawanshi on 26Mar
        IF iv_cat EQ gc_cat_pklst.
          READ TABLE gt_likp_final INTO DATA(lw_likp_final)
          WITH KEY vbeln = lv_del BINARY SEARCH.
          IF sy-subrc IS INITIAL.
            READ TABLE gt_b012 TRANSPORTING NO FIELDS
            WITH KEY lfart = lw_likp_final-lfart BINARY SEARCH.
            IF sy-subrc <> 0.
              rv_block = abap_true.
              RETURN.
            ENDIF.
          ENDIF.
        ENDIF.
*EOI by Ragni Chandrawanshi on 26Mar
        READ TABLE gt_gi_posted WITH KEY vbeln = lv_del TRANSPORTING NO FIELDS.
        IF sy-subrc <> 0.
          rv_block = abap_true.
          RETURN.
        ENDIF.

        " Sales invoice
      WHEN gc_cat_sinv.
        DATA(lv_inv) = CONV vbrk-vbeln( iv_id ).
        DATA(lv_any_linked) = abap_false.
        LOOP AT gt_inv_to_del ASSIGNING FIELD-SYMBOL(<m>) WHERE inv = lv_inv.
          lv_any_linked = abap_true.
          READ TABLE gt_gi_posted WITH KEY vbeln = <m>-del TRANSPORTING NO FIELDS.
          IF sy-subrc <> 0.
            rv_block = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.

        IF lv_any_linked = abap_false.
          rv_block = abap_true.
          RETURN.
        ENDIF.

        " Proforma
      WHEN gc_cat_prfin.
        DATA(lv_prf) = CONV vbrk-vbeln( iv_id ).
        DATA(lv_any_linked2) = abap_false.
        LOOP AT gt_prf_to_del ASSIGNING FIELD-SYMBOL(<p>) WHERE inv = lv_prf.
          lv_any_linked2 = abap_true.
          READ TABLE gt_gi_posted WITH KEY vbeln = <p>-del TRANSPORTING NO FIELDS.
          IF sy-subrc <> 0.
            rv_block = abap_true.
            EXIT.
          ENDIF.
        ENDLOOP.

        IF lv_any_linked2 = abap_false.
          rv_block = abap_true.
          RETURN.
        ENDIF.

    ENDCASE.

  ENDMETHOD.


  METHOD build_fullpath.
    DATA lv_sep TYPE c LENGTH 1.
    cl_gui_frontend_services=>get_file_separator(
      CHANGING file_separator = lv_sep ).
    DATA(lv_dir) = iv_dir.

    " prevent double separators
    WHILE lv_dir IS NOT INITIAL.
      DATA(lv_len) = strlen( lv_dir ).
      IF lv_len = 0.
        EXIT.
      ENDIF.

      DATA(lv_off) = lv_len - 1.

      " Check the last character; trim if it equals the separator
      IF substring( val = lv_dir off = lv_off len = 1 ) = lv_sep.
        lv_dir = lv_dir+0(lv_off).
      ELSE.
        EXIT.
      ENDIF.
    ENDWHILE.


    rv_full = |{ lv_dir }{ lv_sep }{ iv_name }|.

  ENDMETHOD.


