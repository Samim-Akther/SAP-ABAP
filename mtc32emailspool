        SORT gt_view_shipment BY tknum.
        DELETE ADJACENT DUPLICATES FROM gt_view_shipment COMPARING tknum.
        UNASSIGN <g>.
      ENDIF.

      LOOP AT gt_group ASSIGNING <g> WHERE doc_typ = c_sinv.
        APPEND VALUE ty_vbfa_vbeln( vbeln = CONV vbrk-vbeln( <g>-doc_no ) ) TO gt_view_invoice.
      ENDLOOP.

      IF <g> IS ASSIGNED.
        SORT gt_view_invoice BY vbeln.
        DELETE ADJACENT DUPLICATES FROM gt_view_invoice COMPARING vbeln.
        UNASSIGN <g>.
      ENDIF.
      LOOP AT gt_group ASSIGNING <g> WHERE doc_typ = c_pro.
        APPEND VALUE ty_vbfa_vbeln( vbeln = CONV vbrk-vbeln( <g>-doc_no ) ) TO gt_view_proforma.
      ENDLOOP.
      IF <g> IS ASSIGNED.
        SORT gt_view_proforma BY vbeln.
        DELETE ADJACENT DUPLICATES FROM gt_view_proforma COMPARING vbeln.
        UNASSIGN <g>.
      ENDIF.
    ENDIF.

