CLASS lcl_main IMPLEMENTATION.

  METHOD validate_input.
    CONSTANTS:lc_ucomm_execute TYPE sy-ucomm VALUE 'ONLI',
              lc_int           TYPE sx_addrtyp VALUE 'INT'.

    DATA:ls_unstruct     TYPE sx_address,
         lv_normal       TYPE sx_address,
         lv_invalid_mail TYPE string.

    IF sy-ucomm CP '%*'.
      RETURN.
    ENDIF.

    IF s_vbeln[] IS INITIAL AND
         s_bstnk[] IS INITIAL AND
         s_vbldel[] IS INITIAL AND
         s_tknum[]  IS INITIAL AND
         s_vbbill[] IS INITIAL AND
         s_vbprof[] IS INITIAL AND
         s_belnr[]  IS INITIAL.
      MESSAGE e035(zs_mtc_sd).
    ENDIF.

    IF cb_dlvnt IS INITIAL AND cb_pklst IS INITIAL AND cb_cmr IS INITIAL AND
         cb_shprq IS INITIAL AND cb_ldlst IS INITIAL AND
         cb_sinv IS INITIAL AND cb_prfin IS INITIAL.
      MESSAGE e055(zs_mtc_sd) .
    ENDIF.

    IF rb_dwnld = abap_true AND p_dlpath IS INITIAL AND sy-ucomm = lc_ucomm_execute.
      MESSAGE e065(zs_mtc_sd) .
    ELSEIF rb_email = abap_true AND sy-ucomm = lc_ucomm_execute.
      IF p_sender IS INITIAL.
        MESSAGE e058(zs_mtc_sd).
      ELSE.
        CLEAR: ls_unstruct,lv_normal.
        ls_unstruct-type = lc_int.
        ls_unstruct-address = p_sender.
        CALL FUNCTION 'SX_INTERNET_ADDRESS_TO_NORMAL'
          EXPORTING
            address_unstruct    = ls_unstruct
            complete_address    = abap_true
          IMPORTING
            address_normal      = lv_normal
          EXCEPTIONS
            error_address_type  = 1
            error_address       = 2
            error_group_address = 3
            OTHERS              = 4.
        IF sy-subrc <> 0.
          MESSAGE e068(zs_mtc_sd) WITH p_sender.
        ENDIF.
      ENDIF.
      CLEAR lv_invalid_mail.
      IF s_rcv[] IS INITIAL.
        MESSAGE e049(zs_mtc_sd).
      ELSE.
        LOOP AT s_rcv[] ASSIGNING FIELD-SYMBOL(<fs_rcv>).
          CLEAR: ls_unstruct,lv_normal.
          ls_unstruct-type = lc_int.
          ls_unstruct-address = <fs_rcv>-low.
          CALL FUNCTION 'SX_INTERNET_ADDRESS_TO_NORMAL'
            EXPORTING
              address_unstruct    = ls_unstruct
              complete_address    = abap_true
            IMPORTING
              address_normal      = lv_normal
            EXCEPTIONS
              error_address_type  = 1
              error_address       = 2
              error_group_address = 3
              OTHERS              = 4.
          IF sy-subrc <> 0.
            IF lv_invalid_mail IS INITIAL.
              lv_invalid_mail = <fs_rcv>-low.
            ELSE.
              lv_invalid_mail = lv_invalid_mail && gc_separator && <fs_rcv>-low.
            ENDIF.
          ENDIF.

        ENDLOOP.
        IF lv_invalid_mail IS NOT INITIAL.
          MESSAGE e066(zs_mtc_sd) WITH lv_invalid_mail.
        ENDIF.
      ENDIF.
      IF s_cc[] IS NOT INITIAL.
        CLEAR lv_invalid_mail.
        LOOP AT s_cc[] ASSIGNING FIELD-SYMBOL(<fs_cc>).
          CLEAR: ls_unstruct,lv_normal.
          ls_unstruct-type = lc_int.
          ls_unstruct-address = <fs_cc>-low.
          CALL FUNCTION 'SX_INTERNET_ADDRESS_TO_NORMAL'
            EXPORTING
              address_unstruct    = ls_unstruct
              complete_address    = abap_true
            IMPORTING
              address_normal      = lv_normal
            EXCEPTIONS
              error_address_type  = 1
              error_address       = 2
              error_group_address = 3
              OTHERS              = 4.
          IF sy-subrc <> 0.
            IF lv_invalid_mail IS INITIAL.
              lv_invalid_mail = <fs_cc>-low.
            ELSE.
              lv_invalid_mail = lv_invalid_mail && gc_separator && <fs_cc>-low.
            ENDIF.
          ENDIF.
        ENDLOOP.
        IF lv_invalid_mail IS NOT INITIAL.
          MESSAGE e067(zs_mtc_sd) WITH lv_invalid_mail.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDMETHOD.


