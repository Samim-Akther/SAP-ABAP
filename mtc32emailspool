  METHOD extract_shipment.


    TYPES: BEGIN OF ty_vbelv,
             vbeln TYPE vbeln_von,
           END OF ty_vbelv.
    DATA: lt_deliveries         TYPE TABLE OF ty_vbelv,
          lt_vbfa_invoice_valid TYPE ty_vbfa_link_tab.

    CLEAR:  lt_deliveries, lt_vbfa_invoice_valid.

    " 1. Fetch VBFA relations for deliveries
    IF it_shipment IS NOT INITIAL.
      SELECT vbelv, posnv,vbeln,posnn, vbtyp_n
        FROM vbfa
        INTO TABLE @DATA(lt_vbfa_all)
        FOR ALL ENTRIES IN @it_shipment
        WHERE vbeln = @it_shipment-tknum
        AND vbtyp_n = @gc_8.
    ENDIF.

    LOOP AT lt_vbfa_all ASSIGNING FIELD-SYMBOL(<fs_vbfa>).
      APPEND <fs_vbfa>-vbelv TO lt_deliveries.
    ENDLOOP.
    IF <fs_vbfa> IS ASSIGNED.
      UNASSIGN <fs_vbfa>.
    ENDIF.
    SORT lt_deliveries BY vbeln.
    DELETE ADJACENT DUPLICATES FROM lt_deliveries COMPARING vbeln.

    " 2. Validate deliveries in LIKP for VKORG
    IF lt_deliveries IS NOT INITIAL.
      SELECT vbeln,vkorg
        FROM likp
        INTO TABLE @DATA(lt_delivery)
        FOR ALL ENTRIES IN @lt_deliveries
        WHERE vbeln = @lt_deliveries-vbeln
          AND vkorg = @p_vkorg.
      IF sy-subrc = 0.
        SORT lt_delivery BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_delivery COMPARING vbeln.
      ENDIF.
    ENDIF.
    IF lt_delivery IS INITIAL.
      MESSAGE i045(zs_mtc_sd) DISPLAY LIKE gc_e.
      RETURN.
    ENDIF.

    " 3. GI check for deliveries
    IF lt_delivery IS NOT INITIAL.
      SELECT vbeln, wbstk
        FROM vbuk
        INTO TABLE @DATA(lt_vbuk)
        FOR ALL ENTRIES IN @lt_delivery
        WHERE vbeln = @lt_delivery-vbeln.

      IF sy-subrc = 0.
        SORT lt_vbuk BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_vbuk COMPARING vbeln.
      ENDIF.
    ENDIF.

    LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<fs_vbeln>).
      READ TABLE lt_vbuk ASSIGNING FIELD-SYMBOL(<fs_vbuk>) WITH KEY vbeln = <fs_vbeln>-vbeln BINARY SEARCH.
      IF <fs_vbuk> IS NOT ASSIGNED .
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_vbeln>-vbeln ) TO gt_gi_not_posted.
      ELSEIF <fs_vbuk> IS ASSIGNED AND <fs_vbuk>-wbstk <> gc_c.
        APPEND VALUE ty_vbeln_gi(  vbeln = <fs_vbeln>-vbeln ) TO gt_gi_not_posted.
        UNASSIGN <fs_vbuk>.
      ELSEIF <fs_vbuk> IS ASSIGNED AND <fs_vbuk>-wbstk = gc_c.
        APPEND VALUE ty_vbeln_gi(  vbeln = <fs_vbeln>-vbeln ) TO gt_gi_posted.
        UNASSIGN <fs_vbuk>.
      ENDIF.
    ENDLOOP.

    IF <fs_vbeln> IS ASSIGNED.
      UNASSIGN <fs_vbeln>.
    ENDIF.

    SORT gt_gi_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.
    SORT gt_gi_not_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.


    " 4. Fetch invoice headers for all invoice numbers

    IF lt_delivery IS NOT INITIAL.

      SELECT
          a~vbelv,
          a~posnv,
          a~vbeln,
          a~posnn,
          a~vbtyp_n
        FROM vbfa AS a
        INNER JOIN vbrk AS b
          ON b~vbeln = a~vbeln
        INTO TABLE @lt_vbfa_invoice_valid
        FOR ALL ENTRIES IN @lt_delivery
        WHERE a~vbelv   = @lt_delivery-vbeln
          AND a~vbtyp_n IN (@gc_m, @gc_u)
          AND b~vkorg   = @p_vkorg
          AND b~rfbsk  <> @gc_rfbsk_e.

      IF sy-subrc = 0.
        SORT lt_vbfa_invoice_valid BY vbeln vbtyp_n.
        DELETE ADJACENT DUPLICATES FROM lt_vbfa_invoice_valid
          COMPARING vbeln vbtyp_n.
      ENDIF.

    ENDIF.

    """""""""""""""""""""for gi mapping""""""""""""""""""""""""

    "────────────────────────────────────────────────────────────
    " Map Invoice/Proforma -> Delivery from VBFA (Shipment driver)
    "────────────────────────────────────────────────────────────

    LOOP AT lt_vbfa_invoice_valid ASSIGNING FIELD-SYMBOL(<b3>)." WHERE vbtyp_n = gc_m OR vbtyp_n = gc_u.

      CASE <b3>-vbtyp_n.
        WHEN gc_m.
          APPEND VALUE ty_inv_del_map( inv = <b3>-vbeln del = <b3>-vbelv ) TO gt_inv_to_del.
        WHEN gc_u.
          APPEND VALUE ty_inv_del_map( inv = <b3>-vbeln del = <b3>-vbelv ) TO gt_prf_to_del.
        WHEN OTHERS.
      ENDCASE.
    ENDLOOP.

    IF <b3> IS ASSIGNED.
      UNASSIGN <b3>.
    ENDIF.

    SORT gt_inv_to_del BY inv del.
    DELETE ADJACENT DUPLICATES FROM gt_inv_to_del COMPARING inv del.
    SORT gt_prf_to_del BY inv del.
    DELETE ADJACENT DUPLICATES FROM  gt_prf_to_del COMPARING inv del.

    """"""""""grouping"""""""""""""

    SORT lt_vbfa_all            BY vbeln.   " shipment -> delivery
    SORT lt_vbfa_invoice_valid BY vbelv.   " delivery -> bill

    LOOP AT it_shipment ASSIGNING FIELD-SYMBOL(<ls_shp>).   " Shipments (TKNUM)

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_ship
                   doc_no  = <ls_shp>-tknum
                 )
      ).

      me->append_ship_deliv_bills(
        iv_tknum              = <ls_shp>-tknum
        it_vbfa_linked        = lt_vbfa_all
        it_vbfa_invoice_valid = lt_vbfa_invoice_valid
      ).

    ENDLOOP.


  ENDMETHOD.

  METHOD extract_invoice.


    TYPES: BEGIN OF ty_vbeln_str,
             vbeln TYPE vbeln_von,
           END OF ty_vbeln_str.
    DATA: lt_deliveries         TYPE TABLE OF ty_vbeln_str,
          lt_linked_del         TYPE ty_vbeln_tab,
          lt_delivery           TYPE ty_vbeln_tab,
          lt_shipment           TYPE ty_tknum_tab,
          lt_vbfa_invoice_valid TYPE ty_vbfa_link_tab,
          lv_missing_shipment   TYPE string,
          lt_missing_shipment   TYPE TABLE OF string.


    CLEAR: lt_delivery, lt_shipment,lt_vbfa_invoice_valid.


    " 2) VBFA: deliveries
    IF it_invoice IS NOT INITIAL.
      SELECT vbelv, posnv, vbeln, posnn, vbtyp_n,vbtyp_v
        FROM vbfa
        INTO TABLE @DATA(lt_vbfa_all)
        FOR ALL ENTRIES IN @it_invoice
        WHERE vbeln   = @it_invoice-vbeln
        AND vbtyp_v = @gc_j.
    ENDIF.


    LOOP AT lt_vbfa_all ASSIGNING FIELD-SYMBOL(<fs_vbfa>) .
      APPEND VALUE #( vbeln = <fs_vbfa>-vbelv ) TO lt_deliveries.
    ENDLOOP.

    SORT lt_deliveries BY vbeln.
    DELETE ADJACENT DUPLICATES FROM lt_deliveries COMPARING vbeln.

    IF lt_deliveries IS INITIAL.
      MESSAGE i045(zs_mtc_sd) DISPLAY LIKE gc_e .
      RETURN.
    ENDIF.

    " 4) Validate deliveries in LIKP for VKORG
    IF lt_deliveries IS NOT INITIAL.
      SELECT vbeln
        FROM likp
        INTO TABLE @lt_delivery
        FOR ALL ENTRIES IN @lt_deliveries
        WHERE vbeln = @lt_deliveries-vbeln
          AND vkorg = @p_vkorg.
      IF sy-subrc = 0.
        SORT lt_delivery BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_delivery COMPARING vbeln.
      ENDIF.
    ENDIF.



    IF lt_delivery IS INITIAL.
      MESSAGE i045(zs_mtc_sd) DISPLAY LIKE gc_e.
      RETURN.
    ENDIF.


    " 5) GI check for deliveries (kept as-is)
    IF lt_delivery IS NOT INITIAL.
      SELECT vbeln, wbstk
        FROM vbuk
        INTO TABLE @DATA(lt_vbuk)
        FOR ALL ENTRIES IN @lt_delivery
        WHERE vbeln = @lt_delivery-vbeln.
      IF sy-subrc = 0.
        SORT lt_vbuk BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_vbuk COMPARING vbeln.
      ENDIF.
    ENDIF.

    LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<fs_dlv>).
      READ TABLE lt_vbuk ASSIGNING FIELD-SYMBOL(<fs_vbuk>)
           WITH KEY vbeln = <fs_dlv>-vbeln BINARY SEARCH.
      IF  <fs_vbuk> IS NOT ASSIGNED.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_dlv>-vbeln ) TO gt_gi_not_posted.
      ELSEIF  <fs_vbuk> IS ASSIGNED AND <fs_vbuk>-wbstk <> gc_c.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_dlv>-vbeln ) TO gt_gi_not_posted.
        UNASSIGN <fs_vbuk>.
      ELSEIF <fs_vbuk> IS ASSIGNED AND <fs_vbuk>-wbstk = gc_c.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_dlv>-vbeln ) TO gt_gi_posted.
        UNASSIGN <fs_vbuk>.
      ENDIF.
    ENDLOOP.

    IF <fs_dlv> IS ASSIGNED.
      UNASSIGN <fs_dlv>.
    ENDIF.

    SORT gt_gi_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.
    SORT gt_gi_not_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.


    " 6) Shipments linked to deliveries (VBFA-N = '8')
    IF lt_delivery IS NOT INITIAL.
      SELECT vbelv, posnv, vbeln, posnn, vbtyp_n
        FROM vbfa
        INTO TABLE @DATA(lt_ship_vbfa)
        FOR ALL ENTRIES IN @lt_delivery
        WHERE vbelv   = @lt_delivery-vbeln
          AND vbtyp_n = @gc_8.
      IF sy-subrc = 0.
        SORT lt_ship_vbfa BY vbeln.
      ENDIF.
    ENDIF.

    LOOP AT lt_ship_vbfa ASSIGNING FIELD-SYMBOL(<fs_shp_vbfa>).
      APPEND VALUE ty_tknum( tknum = <fs_shp_vbfa>-vbeln ) TO lt_shipment.
    ENDLOOP.

    IF <fs_shp_vbfa> IS ASSIGNED.
      UNASSIGN <fs_shp_vbfa>.
    ENDIF.

    SORT lt_shipment BY tknum.
    DELETE ADJACENT DUPLICATES FROM lt_shipment COMPARING tknum.

    " Validate shipments in VTTK for TPLST
    IF lt_shipment IS NOT INITIAL.
      SELECT tknum, tplst
        FROM vttk
        INTO TABLE @DATA(lt_vttk)
        FOR ALL ENTRIES IN @lt_shipment
        WHERE tknum = @lt_shipment-tknum
          AND tplst = @p_tplst.
      IF sy-subrc = 0.
        SORT lt_vttk BY tknum.
        DELETE ADJACENT DUPLICATES FROM lt_vttk COMPARING tknum.
      ENDIF.
    ENDIF.


    LOOP AT lt_shipment ASSIGNING FIELD-SYMBOL(<fs_ship>).
      READ TABLE lt_vttk TRANSPORTING NO FIELDS
           WITH KEY tknum = <fs_ship>-tknum BINARY SEARCH.
      IF sy-subrc <> 0.
        APPEND |{ <fs_ship>-tknum ALPHA = OUT }| TO lt_missing_shipment.
      ENDIF.
    ENDLOOP.

    IF <fs_ship> IS ASSIGNED.
      UNASSIGN <fs_ship>.
    ENDIF.

    SORT lt_missing_shipment.
    DELETE ADJACENT DUPLICATES FROM lt_missing_shipment.


    CLEAR lv_missing_shipment.
    CONCATENATE LINES OF lt_missing_shipment INTO lv_missing_shipment SEPARATED BY ', '.
    IF lv_missing_shipment IS NOT INITIAL.
      MESSAGE i039(zs_mtc_sd) WITH lv_missing_shipment.
    ENDIF.

    " 7) Linked deliveries for TKNUM -> merge into et_delivery (+GI kept)
    IF lt_vttk IS NOT INITIAL.
      SELECT vbelv, posnv, vbeln, posnn, vbtyp_n
        FROM vbfa
        INTO TABLE @DATA(lt_linked_vbfa)
        FOR ALL ENTRIES IN @lt_vttk
        WHERE vbeln   = @lt_vttk-tknum
          AND vbtyp_n = @gc_8.

      LOOP AT lt_linked_vbfa ASSIGNING FIELD-SYMBOL(<fs_linked>).
        APPEND VALUE ty_vbeln( vbeln = <fs_linked>-vbelv ) TO lt_linked_del.
      ENDLOOP.

      IF <fs_linked> IS ASSIGNED.
        UNASSIGN <fs_linked>.
      ENDIF.

      SORT lt_linked_del BY vbeln.
      DELETE ADJACENT DUPLICATES FROM lt_linked_del COMPARING vbeln.

      " Validate linked deliveries in LIKP for VKORG
      IF lt_linked_del IS NOT INITIAL.
        SELECT vbeln
          FROM likp
          APPENDING TABLE @lt_delivery
          FOR ALL ENTRIES IN @lt_linked_del
          WHERE vbeln = @lt_linked_del-vbeln
            AND vkorg = @p_vkorg.

        IF sy-subrc = 0.
          SORT lt_delivery BY vbeln.
          DELETE ADJACENT DUPLICATES FROM lt_delivery COMPARING vbeln.
        ENDIF.
      ENDIF.

      " GI for linked deliveries

      IF lt_delivery IS NOT INITIAL.
        SELECT vbeln, wbstk
          FROM vbuk
          INTO TABLE @DATA(lt_linked_vbuk)
          FOR ALL ENTRIES IN @lt_delivery
          WHERE vbeln = @lt_delivery-vbeln.
        IF sy-subrc = 0.
          SORT lt_linked_vbuk BY vbeln.
        ENDIF.

        LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<fs_linked_1>).
          READ TABLE lt_linked_vbuk ASSIGNING FIELD-SYMBOL(<fs_linked_stat>)
               WITH KEY vbeln = <fs_linked_1>-vbeln BINARY SEARCH.
          IF <fs_linked_stat> IS NOT ASSIGNED.
            APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_1>-vbeln ) TO gt_gi_not_posted.
          ELSEIF <fs_linked_stat> IS ASSIGNED AND <fs_linked_stat>-wbstk <> gc_c.
            APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_1>-vbeln ) TO gt_gi_not_posted.
          ELSE.
            APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_1>-vbeln ) TO gt_gi_posted.
          ENDIF.
        ENDLOOP.

        SORT gt_gi_posted BY vbeln.
        DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.
        SORT gt_gi_not_posted BY vbeln.
        DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.

        IF <fs_linked_1> IS ASSIGNED.
          UNASSIGN <fs_linked_1>.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lt_delivery IS NOT INITIAL.

      SELECT
          a~vbelv,
          a~posnv,
          a~vbeln,
          a~posnn,
          a~vbtyp_n
        FROM vbfa AS a
        INNER JOIN vbrk AS b
          ON b~vbeln = a~vbeln
        INTO TABLE @lt_vbfa_invoice_valid
        FOR ALL ENTRIES IN @lt_delivery
        WHERE a~vbelv   = @lt_delivery-vbeln
          AND a~vbeln IN @s_vbbill     "++Added by Ragni 05Aug2026
          AND a~vbtyp_n IN (@gc_m, @gc_u)
          AND b~vkorg   = @p_vkorg
          AND b~rfbsk  <> @gc_rfbsk_e.

      IF sy-subrc = 0.
        SORT lt_vbfa_invoice_valid BY vbeln vbtyp_n.
        DELETE ADJACENT DUPLICATES FROM lt_vbfa_invoice_valid
          COMPARING vbeln vbtyp_n.
      ENDIF.
    ENDIF.

    """""""""""""""gi check"""""""""""""""""""""""

    LOOP AT lt_vbfa_invoice_valid ASSIGNING FIELD-SYMBOL(<b4>). "WHERE vbtyp_n = gc_m OR vbtyp_n = gc_u.
      CASE <b4>-vbtyp_n .
        WHEN  gc_m.
          APPEND VALUE ty_inv_del_map( inv = <b4>-vbeln del = <b4>-vbelv ) TO gt_inv_to_del.
        WHEN gc_u.
          APPEND VALUE ty_inv_del_map( inv = <b4>-vbeln del = <b4>-vbelv ) TO gt_prf_to_del.
        WHEN OTHERS.
      ENDCASE.

    ENDLOOP.

    SORT gt_inv_to_del BY inv del.
    DELETE ADJACENT DUPLICATES FROM gt_inv_to_del COMPARING inv del.
    SORT gt_prf_to_del BY inv del.
    DELETE ADJACENT DUPLICATES FROM gt_prf_to_del COMPARING inv del.

    """""""""""""""""""""""""""""""""gi check""""""""""""""""""""""""""""""""""""""""""""""

    """"""""""""""""""""""""grouping""""""""""""""""""""""""""""

    SORT lt_linked_vbfa        BY vbeln.   " shipment -> delivery
    SORT lt_vbfa_invoice_valid BY vbelv.   " delivery -> bill

    "--------------------------------------------------------
    " 1) Shipment-based grouping (Invoice → Shipment path)
    "--------------------------------------------------------
    LOOP AT lt_vttk ASSIGNING FIELD-SYMBOL(<ls_vttk>).   " Shipments (TKNUM)

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_ship
                   doc_no  = <ls_vttk>-tknum
                 )
      ).

      me->append_ship_deliv_bills(
        iv_tknum              = <ls_vttk>-tknum
        it_vbfa_linked        = lt_linked_vbfa
        it_vbfa_invoice_valid = lt_vbfa_invoice_valid
      ).

    ENDLOOP.

    "--------------------------------------------------------
    " 2) Fallback grouping: Deliveries WITHOUT Shipment
    "--------------------------------------------------------
    LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<ls_deliv_fallback>).

      " Already grouped via shipment
      IF line_exists(
           gt_group[
             doc_typ = c_deliv
             doc_no  = <ls_deliv_fallback>-vbeln
           ]
         ).
        CONTINUE.
      ENDIF.

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_deliv
                   doc_no  = <ls_deliv_fallback>-vbeln
                 )
      ).

      me->append_bills_for_delivery(
        iv_delivery_vbeln     = <ls_deliv_fallback>-vbeln
        it_vbfa_invoice_valid = lt_vbfa_invoice_valid
      ).

    ENDLOOP.
  ENDMETHOD.

*  "------------------------------------------------------------
*  " Extraction for Accounting Documents
*  "------------------------------------------------------------

  METHOD extract_accounting.

    DATA:lt_invoice  TYPE ty_vbfa_vbeln_tab.
    CONSTANTS lc_awtyp TYPE awtyp VALUE 'VBRK'.


    "------------------------------
    " Accounting document input
    "------------------------------

    DATA(lv_gjahr_curr) = sy-datum+0(4).
    DATA(lv_gjahr_prev) = lv_gjahr_curr - 1.

    " 1. Get BUKRS from VKORG
    SELECT SINGLE bukrs
      FROM tvko
      INTO @DATA(lv_bukrs)
      WHERE vkorg = @p_vkorg.

    " 2. Fetch BKPF entries for accounting docs
    SELECT bukrs, belnr, gjahr, awtyp, awkey
      FROM bkpf
      INTO TABLE @DATA(lt_bkpf)
      WHERE bukrs = @lv_bukrs
       AND  belnr IN @s_belnr
       AND ( gjahr = @lv_gjahr_curr OR gjahr = @lv_gjahr_prev )
       AND awtyp = @lc_awtyp.
    IF sy-subrc = 0.
      SORT lt_bkpf BY gjahr.
    ENDIF.

    IF lt_bkpf IS INITIAL.
      MESSAGE i043(zs_mtc_sd) DISPLAY LIKE gc_e. " Accounting document not found
      RETURN.
    ENDIF.

    DATA(lt_bkpf_curr) = lt_bkpf.
    DELETE lt_bkpf_curr WHERE gjahr <> lv_gjahr_curr.

    DATA(lt_bkpf_prev) = lt_bkpf.
    DELETE lt_bkpf_prev WHERE gjahr <> lv_gjahr_prev.

    " 3. Build invoice list from AWKEY
    IF lt_bkpf_curr IS NOT INITIAL.
      LOOP AT lt_bkpf_curr ASSIGNING FIELD-SYMBOL(<fs_bkpf>).
        APPEND VALUE ty_vbfa_vbeln( vbeln = <fs_bkpf>-awkey ) TO lt_invoice.
      ENDLOOP.
    ELSE.
      LOOP AT lt_bkpf_prev ASSIGNING <fs_bkpf>.
        APPEND VALUE ty_vbfa_vbeln( vbeln = <fs_bkpf>-awkey ) TO lt_invoice.
      ENDLOOP.
    ENDIF.


    SORT lt_invoice BY vbeln.
    DELETE ADJACENT DUPLICATES FROM lt_invoice COMPARING vbeln.

    " 4. Validate invoices in VBRK for VKORG
    IF lt_invoice IS NOT INITIAL.
      SELECT vbeln,vkorg,rfbsk
        FROM vbrk
        INTO TABLE @DATA(lt_vbrk)
        FOR ALL ENTRIES IN @lt_invoice
        WHERE vbeln = @lt_invoice-vbeln
          AND vkorg = @p_vkorg
        AND   rfbsk NE @gc_rfbsk_e.
    ENDIF.

    IF lt_vbrk IS INITIAL.
      MESSAGE i047(zs_mtc_sd) DISPLAY LIKE gc_e. " Sales invoice not found
      RETURN.
    ENDIF.

    " 5. Continue with invoice extraction logic
    extract_invoice(
      EXPORTING it_invoice   = lt_vbrk  ).   " Sales Invoice


  ENDMETHOD.


