  METHOD fetch_output_types.

    DATA:      lt_doc_types     TYPE RANGE OF rvari_vnam,
               lt_temp_zxysvarv TYPE RANGE OF na_kschl.


    IF cb_dlvnt = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_dlvn }{ gc_sep }{ p_vkorg }| )
       TO lt_doc_types.
    ENDIF.
    IF cb_pklst = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_pklst }{ gc_sep }{ p_vkorg }| )
      TO lt_doc_types.
    ENDIF.
    IF cb_cmr   = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_cmr }{ gc_sep }{ p_vkorg }| )
      TO lt_doc_types.
    ENDIF.
    IF cb_sinv  = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_billdoc }{ gc_sep }{ p_vkorg }| )
       TO lt_doc_types.
    ENDIF.
    IF cb_prfin = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_prfin }{ gc_sep }{ p_vkorg }| )
      TO lt_doc_types.
    ENDIF.
    IF cb_shprq = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_shprq }{ gc_sep }{ p_tplst }| )
      TO lt_doc_types.
    ENDIF.
    IF cb_ldlst = gc_x.
      APPEND VALUE #( sign = gc_i option = gc_eq low = |{ gc_cat_ldlst }{ gc_sep }{ p_tplst }| )
      TO lt_doc_types.
    ENDIF.

    IF lt_doc_types IS NOT INITIAL.

      SELECT progname, name, type, numb, low
        FROM zxysvarv
        INTO TABLE @DATA(lt_zxysvarv)
        WHERE progname = @gc_progname
          AND name     IN @lt_doc_types
          AND type     = @gc_type
          AND low      <> @space.

      IF sy-subrc = 0.
        SORT lt_zxysvarv BY low.
      ENDIF.
    ENDIF.

    LOOP AT lt_zxysvarv ASSIGNING FIELD-SYMBOL(<fs_zxy>).
      APPEND VALUE #( sign = gc_i option = gc_eq low = <fs_zxy>-low ) TO lt_temp_zxysvarv.
*BOI of Ragni Chandrawanshi on 26Mar2026
      IF <fs_zxy>-name CS gc_cat_pklst.
        gv_pack_outtyp = <fs_zxy>-low.
      ENDIF.
*EOI of Ragni Chandrawanshi on 26Mar2026
    ENDLOOP.

    IF <fs_zxy> IS ASSIGNED.
      UNASSIGN <fs_zxy>.
    ENDIF.

    IF lt_temp_zxysvarv IS NOT INITIAL.
      SORT lt_temp_zxysvarv BY low.
      DELETE ADJACENT DUPLICATES FROM lt_temp_zxysvarv COMPARING low.

      SELECT kschl,nacha,kappl
      FROM tnapr
      INTO TABLE @DATA(lt_tnapr)
      WHERE kschl IN @lt_temp_zxysvarv.

      IF sy-subrc = 0.
        DELETE lt_tnapr WHERE kappl IS INITIAL.
        SORT lt_tnapr BY kschl kappl.
      ENDIF.
    ENDIF.

    CLEAR gt_doc_output_types.


    LOOP AT lt_zxysvarv ASSIGNING FIELD-SYMBOL(<fs_doc>).
      READ TABLE lt_tnapr TRANSPORTING NO FIELDS
             WITH KEY kschl = <fs_doc>-low
             BINARY SEARCH.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      DATA(lv_index) = sy-tabix.
      LOOP AT lt_tnapr ASSIGNING FIELD-SYMBOL(<fs_tnapr>) FROM lv_index.

        IF <fs_tnapr>-kschl <> <fs_doc>-low.
          EXIT.
        ENDIF.

        gt_doc_output_types = VALUE #( BASE gt_doc_output_types (
            doc_key     = <fs_doc>-name
            output_type = <fs_doc>-low
            ka          = <fs_tnapr>-kappl
            nacha       = <fs_tnapr>-nacha
        ) ).
      ENDLOOP.
    ENDLOOP.

    DELETE gt_doc_output_types WHERE ka EQ gc_kappl. "output_type EQ gc_kschl
*                                 AND ka EQ gc_kappl.

    IF gt_doc_output_types IS NOT INITIAL.
      SORT gt_doc_output_types BY  doc_key output_type  ka.
      DELETE ADJACENT DUPLICATES FROM gt_doc_output_types COMPARING  doc_key output_type ka.
*      SORT gt_doc_output_types BY doc_key.
    ENDIF.

  ENDMETHOD.



  "---------------------METHOD extract_from_so_input.----------------------
  METHOD extract_from_so_input.

    DATA: lv_missing_delivery TYPE string,
          lv_missing_shipment TYPE string,
          lt_missing_delivery TYPE TABLE OF string,
          lt_missing_shipment TYPE TABLE OF string,
          lt_bill_vbfa_valid  TYPE ty_vbfa_link_tab.

    CLEAR lt_bill_vbfa_valid.

    "--------------------------------------------
    " 1. Extract Deliveries (LIKP) via VBFA
    "--------------------------------------------
    IF it_so IS NOT INITIAL.
      DATA(lt_so_vbeln) = VALUE ty_vbeln_tab(
  FOR <fs> IN it_so ( vbeln = <fs>-vbeln ) ).
      SORT lt_so_vbeln BY vbeln.
      DELETE ADJACENT DUPLICATES FROM lt_so_vbeln COMPARING vbeln.
    ENDIF.
    IF lt_so_vbeln IS NOT INITIAL.
      SELECT vbelv, posnv, vbeln, posnn, vbtyp_n
        FROM vbfa
        INTO TABLE @DATA(lt_vbfa)
          FOR ALL ENTRIES IN @lt_so_vbeln
         WHERE vbelv = @lt_so_vbeln-vbeln
          AND vbtyp_n = @gc_j.
      IF sy-subrc = 0.
        DATA(lt_vbfa1) = lt_vbfa.
        SORT lt_vbfa1 BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_vbfa1 COMPARING vbeln.
      ENDIF.
    ENDIF.

    IF lt_vbfa1 IS NOT INITIAL.
      SELECT vbeln,vkorg
      FROM likp
      INTO TABLE @DATA(lt_delivery)
      FOR ALL ENTRIES IN @lt_vbfa1
      WHERE vbeln = @lt_vbfa1-vbeln
        AND vkorg = @p_vkorg.
      IF sy-subrc = 0.
        SORT lt_delivery BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_delivery COMPARING vbeln.
      ENDIF.
    ELSE.
      MESSAGE i038(zs_mtc_sd) WITH ' ' .
    ENDIF.
    " Collect deliveries & log missing
    LOOP AT lt_vbfa1 ASSIGNING FIELD-SYMBOL(<fs_vbfa>).
      READ TABLE lt_delivery TRANSPORTING NO FIELDS
           WITH KEY vbeln = <fs_vbfa>-vbeln
           BINARY SEARCH.

      IF sy-subrc <> 0.
        APPEND |{ <fs_vbfa>-vbeln ALPHA = OUT }| TO lt_missing_delivery.
      ENDIF.
    ENDLOOP.
    IF <fs_vbfa> IS ASSIGNED.
      UNASSIGN <fs_vbfa>.
    ENDIF.
    SORT lt_missing_delivery.
    DELETE ADJACENT DUPLICATES FROM lt_missing_delivery.

    CLEAR lv_missing_delivery.
    CONCATENATE LINES OF lt_missing_delivery INTO lv_missing_delivery SEPARATED BY gc_separator.

    IF lv_missing_delivery IS NOT INITIAL.
      MESSAGE i038(zs_mtc_sd) WITH  lv_missing_delivery .
    ENDIF.
    "--------------------------------------------
    " 2. Validate Goods Issue
    "--------------------------------------------
    IF lt_delivery IS NOT INITIAL.
      SELECT vbeln, wbstk
        FROM vbuk
        INTO TABLE @DATA(lt_status)
        FOR ALL ENTRIES IN @lt_delivery
        WHERE vbeln = @lt_delivery-vbeln.
      IF sy-subrc = 0.
        SORT lt_status BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_status COMPARING vbeln.
      ENDIF.

      LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<fs_del>).
        READ TABLE lt_status ASSIGNING FIELD-SYMBOL(<fs_stat>)
        WITH KEY vbeln = <fs_del>-vbeln BINARY SEARCH.

        IF <fs_stat> IS NOT ASSIGNED.
          APPEND VALUE #( vbeln = <fs_del>-vbeln ) TO gt_gi_not_posted.
        ELSEIF <fs_stat>-wbstk <> gc_c.
          APPEND VALUE ty_vbeln_gi( vbeln = <fs_del>-vbeln ) TO gt_gi_not_posted.
          UNASSIGN <fs_stat>.
        ELSE.
          APPEND VALUE ty_vbeln_gi( vbeln = <fs_del>-vbeln ) TO gt_gi_posted.
          UNASSIGN <fs_stat>.
        ENDIF.
      ENDLOOP.

      SORT gt_gi_posted BY vbeln.
      DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.
      SORT gt_gi_not_posted BY vbeln.
      DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.

    ENDIF.

    "--------------------------------------------
    " 3. Extract Shipments (VTKK-TKNUM)
    "--------------------------------------------
    IF lt_delivery IS NOT INITIAL.
      " Fetch all shipment links via VBFA
      SELECT vbelv ,posnv,vbeln ,posnn,vbtyp_n
        FROM vbfa
        INTO TABLE @DATA(lt_ship_vbfa)
        FOR ALL ENTRIES IN @lt_delivery
        WHERE vbelv = @lt_delivery-vbeln
        AND vbtyp_n = @gc_8.

      IF sy-subrc = 0.
        SORT lt_ship_vbfa BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_ship_vbfa COMPARING vbeln.
      ENDIF.

      " Fetch VTTK entries for shipment numbers
      IF lt_ship_vbfa IS NOT INITIAL.

        SELECT tknum, tplst
        FROM vttk
        INTO TABLE @DATA(lt_vttk)
        FOR ALL ENTRIES IN @lt_ship_vbfa
        WHERE tknum = @lt_ship_vbfa-vbeln
        AND   tplst = @p_tplst.

        IF sy-subrc = 0.
          SORT lt_vttk BY tknum.
          DELETE ADJACENT DUPLICATES FROM lt_vttk COMPARING tknum.
        ENDIF.
      ENDIF.

      LOOP AT lt_ship_vbfa ASSIGNING FIELD-SYMBOL(<fs_ship>).
        READ TABLE lt_vttk TRANSPORTING NO FIELDS WITH KEY tknum = <fs_ship>-vbeln BINARY SEARCH.
        IF sy-subrc <> 0.
          APPEND |{ <fs_ship>-vbeln ALPHA = OUT }| TO  lt_missing_shipment.
        ENDIF.
      ENDLOOP.

      IF <fs_ship> IS ASSIGNED.
        UNASSIGN <fs_ship>.
      ENDIF.

      SORT  lt_missing_shipment.
      DELETE ADJACENT DUPLICATES FROM lt_missing_shipment.

      CLEAR lv_missing_shipment.
      CONCATENATE LINES OF lt_missing_shipment INTO lv_missing_shipment SEPARATED BY gc_separator.

      IF lv_missing_shipment IS NOT INITIAL.
        MESSAGE i039(zs_mtc_sd) WITH lv_missing_shipment.
      ENDIF.

      " Third extraction: All deliveries linked to TKNUM

      IF lt_vttk IS NOT INITIAL.
        SELECT vbelv,posnv,vbeln, posnn,vbtyp_n
          FROM vbfa
          INTO TABLE @DATA(lt_vbfa_linked)
          FOR ALL ENTRIES IN @lt_vttk
          WHERE vbeln = @lt_vttk-tknum
            AND vbtyp_n = @gc_8.

        IF  sy-subrc = 0.
          SORT lt_vbfa_linked BY vbelv.
          DELETE ADJACENT DUPLICATES FROM lt_vbfa_linked COMPARING vbelv.
        ENDIF.


        IF lt_vbfa_linked IS NOT INITIAL.

          SELECT vbeln, vkorg
              FROM likp
              APPENDING TABLE @lt_delivery
              FOR ALL ENTRIES IN @lt_vbfa_linked
              WHERE vbeln = @lt_vbfa_linked-vbelv
                AND vkorg = @p_vkorg.

          IF sy-subrc = 0.
            SORT lt_delivery BY vbeln.
            DELETE ADJACENT DUPLICATES FROM lt_delivery COMPARING vbeln.


            SELECT vbeln, wbstk
              FROM vbuk
              INTO TABLE @DATA(lt_vbuk_all)
              FOR ALL ENTRIES IN @lt_delivery
              WHERE vbeln = @lt_delivery-vbeln.

            SORT lt_vbuk_all BY vbeln.

            LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<fs_linked_del>).
              READ TABLE lt_vbuk_all ASSIGNING <fs_stat>
                WITH KEY vbeln = <fs_linked_del>-vbeln BINARY SEARCH.

              IF <fs_stat> IS NOT ASSIGNED.
                APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_del>-vbeln ) TO gt_gi_not_posted.
              ELSEIF <fs_stat> IS ASSIGNED AND <fs_stat>-wbstk <> gc_c.
                APPEND VALUE #( vbeln = <fs_linked_del>-vbeln ) TO gt_gi_not_posted.
                UNASSIGN <fs_stat>.
              ELSE.
                APPEND VALUE #( vbeln = <fs_linked_del>-vbeln ) TO gt_gi_posted.
                UNASSIGN <fs_stat>.
              ENDIF.
            ENDLOOP.

            SORT gt_gi_posted BY vbeln.
            DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.

            SORT gt_gi_not_posted BY vbeln.
            DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.

    "--------------------------------------------
    " 4. Extract Sales / Proforma Invoices
    "--------------------------------------------


    IF lt_delivery IS NOT INITIAL.
      SELECT
          a~vbelv,
          a~posnv,
          a~vbeln,
          a~posnn,
          a~vbtyp_n
        FROM vbfa AS a
        INNER JOIN vbrk AS b
          ON b~vbeln = a~vbeln
        INTO TABLE @lt_bill_vbfa_valid
        FOR ALL ENTRIES IN @lt_delivery
        WHERE a~vbelv   = @lt_delivery-vbeln
          AND a~vbtyp_n IN (@gc_m, @gc_u)
          AND b~vkorg   = @p_vkorg
          AND b~rfbsk  <> @gc_rfbsk_e.

      IF sy-subrc = 0.

        SORT lt_bill_vbfa_valid BY vbelv vbeln vbtyp_n.
        DELETE ADJACENT DUPLICATES FROM lt_bill_vbfa_valid
          COMPARING vbelv vbeln vbtyp_n.
      ENDIF.

      """""""for gi check for sales inv / proforma inv"""""""""""""""
      LOOP AT lt_bill_vbfa_valid ASSIGNING FIELD-SYMBOL(<b1>).
        IF <b1>-vbtyp_n = gc_m.      " Sales Invoice
          APPEND VALUE ty_inv_del_map( inv = <b1>-vbeln del = <b1>-vbelv ) TO gt_inv_to_del.
        ELSEIF <b1>-vbtyp_n = gc_u.  " Proforma
          APPEND VALUE ty_inv_del_map( inv = <b1>-vbeln del = <b1>-vbelv ) TO gt_prf_to_del.
        ENDIF.
      ENDLOOP.

      SORT gt_inv_to_del BY inv del.
      DELETE ADJACENT DUPLICATES FROM gt_inv_to_del COMPARING inv del.
      SORT gt_prf_to_del BY inv del.
      DELETE ADJACENT DUPLICATES FROM gt_prf_to_del COMPARING inv del.
    ENDIF.
    """""""""""""""""""""""""""grouping"""""""""""""""""""""""""""""""""""""""



    SORT lt_vbfa_linked      BY vbeln.   " for parallel cursor (shipment -> delivery)
    SORT lt_bill_vbfa_valid  BY vbelv.   " for parallel cursor (delivery -> bill)

    "------------------------------
    " 1) Shipment-based grouping
    "------------------------------
    LOOP AT lt_vttk ASSIGNING FIELD-SYMBOL(<fs_vttk>).  " Shipments

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_ship
                   doc_no  = <fs_vttk>-tknum
                 )
      ).

      me->append_ship_deliv_bills(
        iv_tknum              = <fs_vttk>-tknum
        it_vbfa_linked        = lt_vbfa_linked
        it_vbfa_invoice_valid = lt_bill_vbfa_valid
      ).

    ENDLOOP.

    "--------------------------------------------------------
    " 2) Fallback grouping: Deliveries WITHOUT Shipment
    "--------------------------------------------------------
    LOOP AT lt_delivery ASSIGNING FIELD-SYMBOL(<fs_deliv_fallback>).

      "Skip deliveries already grouped via shipment logic
      IF line_exists(
           gt_group[
             doc_typ = c_deliv
             doc_no  = <fs_deliv_fallback>-vbeln
           ]
         ).
        CONTINUE.
      ENDIF.

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_deliv
                   doc_no  = <fs_deliv_fallback>-vbeln
                 )
      ).

      me->append_bills_for_delivery(
        iv_delivery_vbeln     = <fs_deliv_fallback>-vbeln
        it_vbfa_invoice_valid = lt_bill_vbfa_valid
      ).

    ENDLOOP.

  ENDMETHOD.


*
*  "------------------------------------------------------------
*  " Extraction for Delivery input
*  "------------------------------------------------------------

  METHOD extract_delivery.

    TYPES: BEGIN OF ty_linked_del,
             vbeln TYPE likp-vbeln,
           END OF ty_linked_del.
    DATA: lt_linked_del         TYPE STANDARD TABLE OF ty_linked_del,
          lv_missing_shipment   TYPE string,
          lt_missing_shipment   TYPE TABLE OF string,
          lt_shipment           TYPE ty_tknum_tab,
          lt_all_delivery       TYPE ty_vbeln_tab,
          lt_vbfa_invoice_valid TYPE ty_vbfa_link_tab.

    CLEAR lt_vbfa_invoice_valid.


    lt_all_delivery = it_delivery.

    IF it_delivery IS NOT INITIAL.
      " 1. Goods Issue Check for input deliveries
      SELECT vbeln, wbstk
        FROM vbuk
        INTO TABLE @DATA(lt_vbuk)
        FOR ALL ENTRIES IN @it_delivery
        WHERE vbeln = @it_delivery-vbeln.
      IF sy-subrc = 0.
        SORT lt_vbuk BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_vbuk COMPARING vbeln.
      ENDIF.
    ENDIF.

    LOOP AT it_delivery ASSIGNING FIELD-SYMBOL(<fs_vbeln>).
      READ TABLE lt_vbuk ASSIGNING FIELD-SYMBOL(<fs_vbuk>) WITH KEY vbeln = <fs_vbeln>-vbeln
      BINARY SEARCH.
      IF <fs_vbuk> IS NOT ASSIGNED .
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_vbeln>-vbeln ) TO gt_gi_not_posted.
      ELSEIF <fs_vbuk>-wbstk <> gc_c.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_vbeln>-vbeln ) TO gt_gi_not_posted.
        UNASSIGN <fs_vbuk>.
      ELSE.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_vbeln>-vbeln ) TO gt_gi_posted.
        UNASSIGN <fs_vbuk>.
      ENDIF.
    ENDLOOP.
    IF <fs_vbeln> IS ASSIGNED .
      UNASSIGN <fs_vbeln>.
    ENDIF.

    SORT gt_gi_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.
    SORT gt_gi_not_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.

    IF it_delivery IS NOT INITIAL.
      " 2. Fetch VBFA relations for shipments, invoices, proformas
      SELECT vbelv, posnv, vbeln, posnn, vbtyp_n
        FROM vbfa
         INTO TABLE @DATA(lt_vbfa_all)
        FOR ALL ENTRIES IN @it_delivery
        WHERE vbelv   = @it_delivery-vbeln
         AND vbtyp_n = @gc_8.

      IF sy-subrc = 0.
        DATA(lt_vbfa_all_1) = lt_vbfa_all.
        SORT lt_vbfa_all_1 BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_vbfa_all_1 COMPARING vbeln.
      ENDIF.
    ENDIF.
    IF lt_vbfa_all_1 IS NOT INITIAL.
      " 3. Fetch TKNUM details for shipments
      SELECT tknum, tplst
        FROM vttk
        INTO TABLE @DATA(lt_vttk)
        FOR ALL ENTRIES IN @lt_vbfa_all_1
        WHERE tknum = @lt_vbfa_all_1-vbeln
        AND tplst =   @p_tplst.

      IF sy-subrc = 0.
        SORT lt_vttk BY tknum.
        DELETE ADJACENT DUPLICATES FROM lt_vttk COMPARING tknum.
      ENDIF.
    ENDIF.

    " 4. Shipment extraction and missing shipments
    LOOP AT lt_vbfa_all ASSIGNING FIELD-SYMBOL(<fs_vbfa>) WHERE vbtyp_n = gc_8.
      READ TABLE lt_vttk TRANSPORTING NO FIELDS WITH KEY tknum = <fs_vbfa>-vbeln
      BINARY SEARCH.
      IF sy-subrc = 0.
        APPEND VALUE #( tknum = <fs_vbfa>-vbeln ) TO lt_shipment.
      ELSE.
        APPEND |{ <fs_vbfa>-vbeln ALPHA = OUT }| TO lt_missing_shipment.
      ENDIF.
    ENDLOOP.
    IF <fs_vbfa> IS ASSIGNED.
      UNASSIGN <fs_vbfa>.
    ENDIF.

    SORT lt_shipment BY tknum.
    DELETE ADJACENT DUPLICATES FROM lt_shipment COMPARING tknum.


    SORT lt_missing_shipment.
    DELETE ADJACENT DUPLICATES FROM lt_missing_shipment.

    CLEAR lv_missing_shipment.

    CONCATENATE LINES OF lt_missing_shipment INTO lv_missing_shipment SEPARATED BY gc_separator.
    IF lv_missing_shipment IS NOT INITIAL.
      MESSAGE i039(zs_mtc_sd) WITH lv_missing_shipment.
    ENDIF.

    " 5. Linked deliveries via TKNUM
    IF lt_vttk IS NOT INITIAL.
      SELECT vbelv, posnv, vbeln, posnn, vbtyp_n
        FROM vbfa
        INTO TABLE @DATA(lt_vbfa_linked)
        FOR ALL ENTRIES IN @lt_vttk
        WHERE vbeln = @lt_vttk-tknum
          AND vbtyp_n = @gc_8.

      IF sy-subrc = 0.
        DATA(lt_vbfa_linked_1) = lt_vbfa_linked.
        SORT lt_vbfa_linked_1 BY vbelv.
        DELETE ADJACENT DUPLICATES FROM lt_vbfa_linked_1 COMPARING vbelv.
      ENDIF.

      IF lt_vbfa_linked_1 IS NOT INITIAL.
        SELECT vbeln
          FROM likp
          INTO TABLE @lt_linked_del
          FOR ALL ENTRIES IN @lt_vbfa_linked_1
          WHERE vbeln = @lt_vbfa_linked_1-vbelv
            AND vkorg = @p_vkorg.
        IF sy-subrc = 0.
          SORT lt_linked_del BY vbeln.
          DELETE ADJACENT DUPLICATES FROM lt_linked_del COMPARING vbeln.
        ENDIF.

        IF lt_linked_del IS NOT INITIAL.
          APPEND LINES OF lt_linked_del TO lt_all_delivery.
          SORT lt_all_delivery BY vbeln.
          DELETE ADJACENT DUPLICATES FROM lt_all_delivery COMPARING vbeln.
        ENDIF.
      ENDIF.
    ENDIF.
    IF lt_all_delivery IS NOT INITIAL.
      " 6. GI check for all deliveries
      SELECT vbeln, wbstk
        FROM vbuk
        INTO TABLE @DATA(lt_vbuk_linked)
        FOR ALL ENTRIES IN @lt_all_delivery
        WHERE vbeln = @lt_all_delivery-vbeln.
      IF sy-subrc = 0.
        SORT lt_vbuk_linked BY vbeln.
        DELETE ADJACENT DUPLICATES FROM lt_vbuk_linked COMPARING vbeln.
      ENDIF.
    ENDIF.

    LOOP AT lt_all_delivery ASSIGNING FIELD-SYMBOL(<fs_linked_del>).
      READ TABLE lt_vbuk_linked ASSIGNING FIELD-SYMBOL(<fs_linked_stat>)
      WITH KEY vbeln = <fs_linked_del>-vbeln BINARY SEARCH.
      IF <fs_linked_stat> IS NOT ASSIGNED .
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_del>-vbeln ) TO gt_gi_not_posted.
      ELSEIF <fs_linked_stat>-wbstk <> gc_c.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_del>-vbeln ) TO gt_gi_not_posted.
        UNASSIGN <fs_linked_stat>.
      ELSE.
        APPEND VALUE ty_vbeln_gi( vbeln = <fs_linked_del>-vbeln ) TO gt_gi_posted.
        UNASSIGN <fs_linked_stat>.
      ENDIF.
    ENDLOOP.
    IF <fs_linked_del> IS  ASSIGNED.
      UNASSIGN <fs_linked_del>.
    ENDIF.

    SORT gt_gi_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_posted COMPARING vbeln.
    SORT gt_gi_not_posted BY vbeln.
    DELETE ADJACENT DUPLICATES FROM gt_gi_not_posted COMPARING vbeln.

*      " 7. Fetch invoice headers
    IF lt_all_delivery IS NOT INITIAL.
      SELECT
          a~vbelv,
          a~posnv,
          a~vbeln,
          a~posnn,
          a~vbtyp_n
        FROM vbfa AS a
        INNER JOIN vbrk AS b
          ON b~vbeln = a~vbeln
        INTO TABLE @lt_vbfa_invoice_valid
        FOR ALL ENTRIES IN @lt_all_delivery
        WHERE a~vbelv   = @lt_all_delivery-vbeln
          AND a~vbtyp_n IN (@gc_m, @gc_u)
          AND b~vkorg   = @p_vkorg
          AND b~rfbsk  <> @gc_rfbsk_e.

      IF sy-subrc = 0.
        SORT lt_vbfa_invoice_valid BY vbelv vbeln vbtyp_n.
        DELETE ADJACENT DUPLICATES FROM lt_vbfa_invoice_valid
          COMPARING vbelv vbeln vbtyp_n.
      ENDIF.
    ENDIF.


    """"""""""""""""""""for gi checking""""""""""""""""""""""""""""""""

    LOOP AT lt_vbfa_invoice_valid ASSIGNING FIELD-SYMBOL(<b2>).
      CASE <b2>-vbtyp_n.
        WHEN gc_m.
          APPEND VALUE ty_inv_del_map( inv = <b2>-vbeln del = <b2>-vbelv ) TO gt_inv_to_del.
        WHEN gc_u.
          APPEND VALUE ty_inv_del_map( inv = <b2>-vbeln del = <b2>-vbelv ) TO gt_prf_to_del.
        WHEN OTHERS.
      ENDCASE.
    ENDLOOP.

    IF <b2> IS ASSIGNED.
      UNASSIGN <b2>.
    ENDIF.

    SORT gt_inv_to_del BY inv del.
    DELETE ADJACENT DUPLICATES FROM gt_inv_to_del COMPARING inv del.
    SORT gt_prf_to_del BY inv del.
    DELETE ADJACENT DUPLICATES FROM gt_prf_to_del COMPARING inv del.
    """""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

    """"""""""""""GROUPING"""""""""""

    SORT lt_vbfa_linked        BY vbeln.  "shipment->delivery
    SORT lt_vbfa_invoice_valid BY vbelv.  "delivery->bill

    "------------------------------------
    " Shipment loop (lt_vttk)
    "------------------------------------
    LOOP AT lt_vttk ASSIGNING FIELD-SYMBOL(<fs_vttk>).  " Shipments (TKNUM)

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_ship
                   doc_no  = <fs_vttk>-tknum
                 )
      ).

      me->append_ship_deliv_bills(
        iv_tknum              = <fs_vttk>-tknum
        it_vbfa_linked        = lt_vbfa_linked
        it_vbfa_invoice_valid = lt_vbfa_invoice_valid
      ).

    ENDLOOP.

*    "--------------------------------------------------------
*    " Fallback grouping: INPUT Deliveries WITHOUT Shipment
*    "--------------------------------------------------------
    LOOP AT it_delivery ASSIGNING FIELD-SYMBOL(<fs_deliv_fallback>).

      IF line_exists( gt_group[ doc_typ = c_deliv
                                doc_no  = <fs_deliv_fallback>-vbeln ] ).
        CONTINUE.
      ENDIF.

      me->add_group_anchor(
        is_key = VALUE ty_group_key(
                   doc_typ = c_deliv
                   doc_no  = <fs_deliv_fallback>-vbeln
                 )
      ).

      me->append_bills_for_delivery(
        iv_delivery_vbeln     = <fs_deliv_fallback>-vbeln
        it_vbfa_invoice_valid = lt_vbfa_invoice_valid
      ).

    ENDLOOP.
  ENDMETHOD.

