      ENDIF.

      IF lt_tmp_delivery IS INITIAL.
*        MESSAGE e045(zs_mtc_sd). " Delivery not found
        MESSAGE i045(zs_mtc_sd) DISPLAY LIKE gc_e. " Delivery not found
      ELSE.
        CLEAR: lt_tmp_shipment, lt_tmp_invoice, lt_tmp_proforma.
        extract_delivery(
          EXPORTING it_delivery = lt_tmp_delivery ).
      ENDIF.
    ENDIF.

    "------------------------------
    " 4) Shipment input
    "------------------------------
    IF s_tknum[] IS NOT INITIAL.
      CLEAR lt_tmp_shipment.
      SELECT tknum
        FROM vttk
        INTO TABLE @lt_tmp_shipment
        WHERE tknum IN @s_tknum
          AND tplst  = @p_tplst.

      IF lt_tmp_shipment IS INITIAL.
*        MESSAGE e046(zs_mtc_sd). " Shipment not found
        MESSAGE i046(zs_mtc_sd) DISPLAY LIKE gc_e. " Shipment not found
      ELSE.
        CLEAR: lt_tmp_delivery, lt_tmp_invoice, lt_tmp_proforma.
        extract_shipment(
          EXPORTING it_shipment = lt_tmp_shipment ).
      ENDIF.
    ENDIF.

    "------------------------------
    " 5) Billing input (Sales invoice)
    "------------------------------
    IF s_vbbill[] IS NOT INITIAL.
      CLEAR lt_tmp_invoice.
      SELECT vbeln,vkorg,rfbsk
        FROM vbrk
        INTO TABLE @lt_tmp_invoice
        WHERE vbeln IN @s_vbbill
          AND vkorg  = @p_vkorg
        AND   rfbsk NE @gc_rfbsk_e.

      IF lt_tmp_invoice IS INITIAL.
*        MESSAGE e047(zs_mtc_sd). " Sales invoice not found
        MESSAGE i047(zs_mtc_sd) DISPLAY LIKE gc_e. " Sales invoice not found

      ELSE.
        CLEAR: lt_tmp_delivery, lt_tmp_shipment, lt_tmp_proforma.
        extract_invoice(
          EXPORTING it_invoice = lt_tmp_invoice ).

      ENDIF.
    ENDIF.

    "------------------------------
    " 6) Proforma input
    "------------------------------
    IF s_vbprof[] IS NOT INITIAL.
      CLEAR lt_tmp_proforma.
      SELECT vbeln,vkorg,rfbsk
        FROM vbrk
        INTO TABLE @lt_tmp_proforma
        WHERE vbeln IN @s_vbprof
          AND vkorg  = @p_vkorg
          AND   rfbsk NE @gc_rfbsk_e.

      IF lt_tmp_proforma IS INITIAL.
*        MESSAGE e048(zs_mtc_sd). " Proforma not found
        MESSAGE i048(zs_mtc_sd) DISPLAY LIKE gc_e. " Proforma not found
      ELSE.
        CLEAR: lt_tmp_delivery, lt_tmp_shipment, lt_tmp_invoice.
        extract_invoice(
          EXPORTING it_invoice = lt_tmp_proforma ).
      ENDIF.
    ENDIF.

    "------------------------------
    " 7) Accounting document input
    "------------------------------
    IF s_belnr[] IS NOT INITIAL.
      CLEAR: lt_tmp_delivery, lt_tmp_shipment, lt_tmp_invoice, lt_tmp_proforma.
      extract_accounting( ).
    ENDIF.

    IF gt_group IS NOT INITIAL.

      LOOP AT gt_group ASSIGNING FIELD-SYMBOL(<g>) WHERE doc_typ = c_deliv.
        APPEND VALUE ty_vbeln( vbeln = CONV likp-vbeln( <g>-doc_no ) ) TO gt_view_delivery.
      ENDLOOP.
      IF <g> IS ASSIGNED.
        SORT gt_view_delivery BY vbeln.
