  METHOD add_group_anchor.

    IF line_exists( gt_group[ doc_no = is_key-doc_no ] ).
      RETURN.
    ENDIF.

    gv_group = gv_group + 1.

    APPEND VALUE ty_group(
             doc_typ = is_key-doc_typ
             doc_no  = is_key-doc_no
             group   = gv_group
           ) TO gt_group.

  ENDMETHOD.

  METHOD append_ship_deliv_bills.

    READ TABLE it_vbfa_linked ASSIGNING FIELD-SYMBOL(<fs_deliv>)
         WITH KEY vbeln = iv_tknum
         BINARY SEARCH.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    DATA(lv_deliv_idx) = sy-tabix.

    LOOP AT it_vbfa_linked ASSIGNING <fs_deliv> FROM lv_deliv_idx.

      IF <fs_deliv>-vbeln <> iv_tknum.
        EXIT.
      ENDIF.

      IF line_exists( gt_group[ doc_no = <fs_deliv>-vbelv ] ).
        CONTINUE.
      ENDIF.

      APPEND VALUE ty_group(
        doc_typ = c_deliv
        doc_no  = <fs_deliv>-vbelv
        group   = gv_group
      ) TO gt_group.


      READ TABLE it_vbfa_invoice_valid ASSIGNING FIELD-SYMBOL(<fs_bill>)
           WITH KEY vbelv = <fs_deliv>-vbelv
           BINARY SEARCH.
      IF sy-subrc <> 0.
        CONTINUE.
      ENDIF.

      DATA(lv_bill_idx) = sy-tabix.

      LOOP AT it_vbfa_invoice_valid ASSIGNING <fs_bill> FROM lv_bill_idx.

        IF <fs_bill>-vbelv <> <fs_deliv>-vbelv.
          EXIT.
        ENDIF.

        IF <fs_bill>-vbtyp_n <> gc_m AND <fs_bill>-vbtyp_n <> gc_u.
          CONTINUE.
        ENDIF.

        IF line_exists( gt_group[ doc_no = <fs_bill>-vbeln ] ).
          CONTINUE.
        ENDIF.

        CASE <fs_bill>-vbtyp_n.
          WHEN gc_m.
            APPEND VALUE ty_group(
              doc_typ = c_sinv
              doc_no  = <fs_bill>-vbeln
              group   = gv_group
            ) TO gt_group.
          WHEN gc_u.
            APPEND VALUE ty_group(
              doc_typ = c_pro
              doc_no  = <fs_bill>-vbeln
              group   = gv_group
            ) TO gt_group.
        ENDCASE.

      ENDLOOP.

    ENDLOOP.

  ENDMETHOD.
  METHOD append_bills_for_delivery.



    READ TABLE it_vbfa_invoice_valid ASSIGNING FIELD-SYMBOL(<fs_bill_fallback>)
         WITH KEY vbelv = iv_delivery_vbeln
         BINARY SEARCH.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    DATA(lv_bill_idx) = sy-tabix.

    LOOP AT it_vbfa_invoice_valid ASSIGNING <fs_bill_fallback> FROM lv_bill_idx.

      IF <fs_bill_fallback>-vbelv <> iv_delivery_vbeln.
        EXIT.
      ENDIF.

      IF <fs_bill_fallback>-vbtyp_n <> gc_m AND <fs_bill_fallback>-vbtyp_n <> gc_u.
        CONTINUE.
      ENDIF.

      IF line_exists( gt_group[ doc_no = <fs_bill_fallback>-vbeln ] ).
        CONTINUE.
      ENDIF.

      CASE <fs_bill_fallback>-vbtyp_n.
        WHEN gc_m.
          APPEND VALUE ty_group(
            doc_typ = c_sinv
            doc_no  = <fs_bill_fallback>-vbeln
            group   = gv_group
          ) TO gt_group.

        WHEN gc_u.
          APPEND VALUE ty_group(
            doc_typ = c_pro
            doc_no  = <fs_bill_fallback>-vbeln
            group   = gv_group
          ) TO gt_group.
      ENDCASE.

    ENDLOOP.

  ENDMETHOD.

  METHOD preload_mkpf_for_deliveries.
    TYPES: BEGIN OF ty_xblnr,
             xblnr TYPE xblnr1,
           END OF ty_xblnr.
    DATA: lt_vbfa  TYPE STANDARD TABLE OF vbfavb,
          lt_vbfa2 TYPE STANDARD TABLE OF vbfavb,
          lv_vbeln TYPE vbeln.
    DATA: lt_xblnr_keys TYPE TABLE OF ty_xblnr.
    CLEAR gt_mkpf_by_xblnr.

    IF it_delivery IS INITIAL.
      RETURN.
    ENDIF.


    lt_xblnr_keys = VALUE #( FOR d IN it_delivery ( |{ d-vbeln ALPHA = IN }| ) ).
    SORT lt_xblnr_keys.
    DELETE ADJACENT DUPLICATES FROM lt_xblnr_keys.


    FREE: lt_vbfa.
    LOOP AT lt_xblnr_keys INTO DATA(wa_keys).

      FREE lt_vbfa2.
      lv_vbeln = wa_keys-xblnr.
      CALL FUNCTION 'SD_VBFA_READ_WITH_VBELV'
        EXPORTING
          i_vbelv          = lv_vbeln
        TABLES
          et_vbfavb        = lt_vbfa2
        EXCEPTIONS
          record_not_found = 1
          OTHERS           = 2.
      IF sy-subrc EQ 0.
        APPEND LINES OF lt_vbfa2 TO lt_vbfa.
      ENDIF.
    ENDLOOP.

    DELETE lt_vbfa WHERE vbtyp_n NE 'h'. "returns
    IF lt_vbfa[] IS NOT INITIAL.
      SELECT mblnr,
             smbln
             FROM mseg
            FOR ALL ENTRIES IN @lt_vbfa
            WHERE mblnr EQ @lt_vbfa-vbeln
              AND mjahr EQ @lt_vbfa-mjahr
              INTO TABLE @DATA(lt_mseg_ret).
    ENDIF.

    SELECT  mblnr, mjahr,xblnr
      FROM  mkpf
      INTO  TABLE @gt_mkpf_by_xblnr
      FOR ALL ENTRIES IN @lt_xblnr_keys
      WHERE xblnr = @lt_xblnr_keys-xblnr.
    IF sy-subrc = 0.
      DATA(lt_xb2) = gt_mkpf_by_xblnr[].
      FREE gt_mkpf_by_xblnr.
      LOOP AT lt_xb2 INTO DATA(wa_xblnr).
        IF NOT line_exists( lt_mseg_ret[ smbln = wa_xblnr-mblnr ] )
         AND NOT line_exists( lt_mseg_ret[ mblnr = wa_xblnr-mblnr ] ).
          APPEND wa_xblnr TO gt_mkpf_by_xblnr.
        ENDIF.
      ENDLOOP.

      SORT gt_mkpf_by_xblnr BY xblnr.
      DELETE ADJACENT DUPLICATES FROM gt_mkpf_by_xblnr COMPARING xblnr.
    ELSE.
      RETURN.
    ENDIF.
  ENDMETHOD.



