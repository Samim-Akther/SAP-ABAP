*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_0100 INPUT.

  DATA lt_selected TYPE STANDARD TABLE OF ty_alv .
  DATA lt_attach TYPE zattachement_tt.
  DATA:ls_att     TYPE zattachement,
       lv_subject TYPE so_obj_des,

       lv_size    TYPE i.
  DATA: lt_body         TYPE bcsy_text,
        lv_subject_base TYPE string,
        lv_body_text    TYPE string,
        lt_obj          TYPE bcsy_text.
  DATA(lv_key) = VALUE string( ).
  DATA: lv_ok    TYPE abap_bool,
        lv_sname TYPE tdobname,
        lv_bname TYPE tdobname.

  CASE sy-ucomm.
    WHEN 'EXIT' OR 'BACK' OR 'CANCEL'.
      LEAVE TO SCREEN 0.

    WHEN 'SEND'.
      IF ( cb_dlvnt = abap_true OR cb_pklst = abap_true )" OR cb_cmr = abap_true )
        AND gt_view_delivery IS NOT INITIAL.
        lo_main->preload_mkpf_for_deliveries( EXPORTING it_delivery = gt_view_delivery ).
      ENDIF.

      IF ( cb_sinv = abap_true OR cb_prfin = abap_true )
           AND gt_view_invoice  IS NOT INITIAL.
        lo_main->preload_bkpf_for_billings( EXPORTING it_billing  = gt_view_invoice  ).
      ENDIF.

      DATA(lo_email) = NEW zcl_email_sender( ).
      IF g_grid IS BOUND.
        CALL METHOD g_grid->check_changed_data.
      ENDIF.

      CLEAR:lt_selected.
      LOOP AT gt_alv ASSIGNING FIELD-SYMBOL(<fs_alv>) WHERE check_box = gc_x.
        APPEND <fs_alv> TO lt_selected.
      ENDLOOP.
      IF <fs_alv> IS ASSIGNED.
        UNASSIGN <fs_alv>.
      ENDIF.
      IF lt_selected IS INITIAL.
        MESSAGE i053(zs_mtc_sd).
        RETURN.
      ENDIF.

      SORT lt_selected BY group doc_cat doc_id document.
      DELETE ADJACENT DUPLICATES FROM lt_selected COMPARING group doc_cat doc_id document.

*      DATA(lo_main) = NEW lcl_main( ).
      CLEAR:lt_body,lv_subject_base,lt_obj, lv_bname, lv_sname.
      lo_main->get_text_name( EXPORTING iv_type = gc_sub "++@@Added by Ragni Chandrawanshi on 03Mar2026
                              IMPORTING ev_name = lv_sname )."++@@Added by Ragni Chandrawanshi on 27Feb2026
      lo_main->get_text_name( EXPORTING iv_type = gc_body "++@@Added by Ragni Chandrawanshi on 03Mar2026
                              IMPORTING ev_name = lv_bname )."++@@Added by Ragni Chandrawanshi on 27Feb2026
      lo_main->get_so10_text( EXPORTING iv_name = lv_bname "'ZMAILOUTBODY' "++@@Modified by Ragni Chandrawanshi on 03Mar2026
                              IMPORTING et_text = lt_body ).
      lo_main->get_so10_text( EXPORTING iv_name = lv_sname "'ZMAILOUTOBJ' "++@@Modified by Ragni Chandrawanshi on 27Feb2026
                              IMPORTING et_text = lt_obj ).
      lv_subject_base = lo_main->bcsy_to_string( lt_obj ).

      LOOP AT lt_selected INTO DATA(ls_row)
           GROUP BY ( grp = ls_row-group ) ASCENDING ASSIGNING FIELD-SYMBOL(<grp>).

        CLEAR: lt_attach, lv_subject.
        lv_subject = lv_subject_base.

        DATA(lv_grp_txt) = COND string( WHEN <grp>-grp IS INITIAL THEN `N/A` ELSE <grp>-grp ).
        LOOP AT GROUP <grp> ASSIGNING FIELD-SYMBOL(<gdoc>).

          CLEAR:lv_key.

          CASE <gdoc>-doc_cat.
            WHEN gc_cat_dlvn.
              lv_key = |{ gc_cat_dlvn }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_pklst.
              lv_key = |{ gc_cat_pklst }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_sinv.
              lv_key = |{ gc_cat_billdoc }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_prfin.
              lv_key = |{ gc_cat_prfin }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_shprq.
              lv_key = |{ gc_cat_shprq }{ gc_sep }{ p_tplst }|.
            WHEN gc_cat_ldlst.
              lv_key = |{ gc_cat_ldlst }{ gc_sep }{ p_tplst }|.
            WHEN OTHERS.
              CONTINUE.
          ENDCASE.

          CLEAR:ls_att.
          ls_att = lo_main->generate_attachment(
                   EXPORTING iv_docnum       = <gdoc>-doc_id
                             iv_doc_category = <gdoc>-doc_cat
                             iv_key          = lv_key
                   IMPORTING ev_size         = lv_size
                 ).
          IF ls_att-content IS INITIAL OR lv_size <= 0.
            CONTINUE. " skip invalid attachment
          ENDIF.

          APPEND ls_att TO lt_attach.

        ENDLOOP.

        UNASSIGN <gdoc>.


        IF lo_email IS BOUND.
          CLEAR:lv_ok.

          IF lt_attach IS INITIAL.
            MESSAGE i052(zs_mtc_sd) WITH lv_grp_txt.
            CONTINUE.
          ENDIF.

          lv_ok = lo_email->send_email(
                         iv_subject       = lv_subject
                           it_body          = lt_body
                           iv_sender        = p_sender
                           iv_recipients    = lo_main->csv_from_sels( s_rcv[] )
                           iv_cc            = lo_main->csv_from_sels( s_cc[] )
                           iv_doc_type      = 'RAW'
                           iv_delimiter     = ';'
                           iv_attachment_type = 'PDF'
                           it_attachments   = lt_attach ).

          IF lv_ok = abap_true.
*            MESSAGE i051(zs_mtc_sd) DISPLAY LIKE 'S' WITH lv_grp_txt .
            MESSAGE s051(zs_mtc_sd)  .

          ELSE.
            MESSAGE i050(zs_mtc_sd) DISPLAY LIKE gc_e WITH lv_grp_txt.
            CONTINUE.
          ENDIF.
        ENDIF.
      ENDLOOP.
      IF <grp> IS ASSIGNED.
        UNASSIGN <grp>.
      ENDIF.

    WHEN 'PREVIEW'.

      DATA lr_outlook     TYPE ole2_object.
      DATA lr_mail        TYPE ole2_object.
      DATA lr_attachments TYPE ole2_object.

      DATA lt_path  TYPE STANDARD TABLE OF string .
      DATA:lv_to TYPE string,
           lv_cc TYPE string.

      IF ( cb_dlvnt = abap_true OR cb_pklst = abap_true )" OR cb_cmr = abap_true )
              AND gt_view_delivery IS NOT INITIAL.
        lo_main->preload_mkpf_for_deliveries( EXPORTING it_delivery = gt_view_delivery ).
      ENDIF.

      IF ( cb_sinv = abap_true OR cb_prfin = abap_true )
           AND gt_view_invoice  IS NOT INITIAL.
        lo_main->preload_bkpf_for_billings( EXPORTING it_billing  = gt_view_invoice  ).
      ENDIF.

      IF g_grid IS BOUND.
        CALL METHOD g_grid->check_changed_data.
      ENDIF.

      CLEAR:lt_selected.
      LOOP AT gt_alv ASSIGNING <fs_alv> WHERE check_box = gc_x.
        APPEND <fs_alv> TO lt_selected.
      ENDLOOP.
      UNASSIGN <fs_alv>.
      IF lt_selected IS INITIAL.
        MESSAGE i053(zs_mtc_sd).
        RETURN.
      ENDIF.

      DATA(lv_base_dir) = p_dlpath.
      CONDENSE lv_base_dir.
      IF lv_base_dir IS INITIAL.

        CALL METHOD cl_gui_frontend_services=>directory_browse
          CHANGING
            selected_folder      = lv_base_dir
          EXCEPTIONS
            cntl_error           = 1
            error_no_gui         = 2
            not_supported_by_gui = 3
            OTHERS               = 4.
        IF sy-subrc <> 0.
          MESSAGE ID sy-msgid TYPE gc_i  NUMBER sy-msgno DISPLAY LIKE gc_e
                     WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
          RETURN.
        ENDIF.

      ENDIF.
      CLEAR:lt_body,lt_obj,lv_subject_base,lv_body_text, lv_bname, lv_sname.
      lo_main->get_text_name( EXPORTING iv_type = gc_sub "++@@Added by Ragni Chandrawanshi on 03Mar2026
                             IMPORTING ev_name = lv_sname )."++@@Added by Ragni Chandrawanshi on 27Feb2026
      lo_main->get_text_name( EXPORTING iv_type = gc_body "++@@Added by Ragni Chandrawanshi on 03Mar2026
                              IMPORTING ev_name = lv_bname )."++@@Added by Ragni Chandrawanshi on 03Mar2026
      lo_main->get_so10_text( EXPORTING iv_name = lv_bname "'ZMAILOUTBODY' "++@@Added by Ragni Chandrawanshi on 03Mar2026
                              IMPORTING et_text = lt_body ).
      lo_main->get_so10_text( EXPORTING iv_name = lv_sname  "'ZMAILOUTOBJ' "++@@Modified by Ragni Chandrawanshi on 27Feb2026
                              IMPORTING et_text = lt_obj  ).
      lv_subject_base = lo_main->bcsy_to_string( lt_obj ).
      LOOP AT lt_body ASSIGNING FIELD-SYMBOL(<fs_line>).
        DATA(lv_line) = CONV string( <fs_line>-line ).
        IF lv_body_text IS INITIAL.
          lv_body_text = lv_line.
        ELSE.
          lv_body_text = lv_body_text && cl_abap_char_utilities=>cr_lf && lv_line.
        ENDIF.
      ENDLOOP.

      IF <fs_line> IS ASSIGNED.
        UNASSIGN <fs_line>.
      ENDIF.

      CLEAR:lv_to,lv_cc.
      lv_to = lo_main->csv_from_sels( s_rcv[] ).
      lv_cc = lo_main->csv_from_sels( s_cc[] ).

      SORT lt_selected BY group doc_cat doc_id document.
      DELETE ADJACENT DUPLICATES FROM lt_selected COMPARING group doc_cat doc_id document.


      LOOP AT lt_selected INTO ls_row
           GROUP BY ( grp = ls_row-group ) ASCENDING
           ASSIGNING <grp>.
        CLEAR:lt_path,lv_subject.
        lv_subject = lv_subject_base.

        " Build attachments only from the checked lines of this group
        LOOP AT GROUP <grp> ASSIGNING <gdoc>.

          CLEAR:lv_key.
          CASE <gdoc>-doc_cat.
            WHEN gc_cat_dlvn.
              lv_key = |{ gc_cat_dlvn }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_pklst.
              lv_key = |{ gc_cat_pklst }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_sinv.
              lv_key = |{ gc_cat_billdoc }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_prfin.
              lv_key = |{ gc_cat_prfin }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_shprq.
              lv_key = |{ gc_cat_shprq }{ gc_sep }{ p_tplst }|.
            WHEN gc_cat_cmr.
              lv_key = |{ gc_cat_cmr }{ gc_sep }{ p_vkorg }|.
            WHEN gc_cat_ldlst.
              lv_key = |{ gc_cat_ldlst }{ gc_sep }{ p_tplst }|.
            WHEN OTHERS.
              CONTINUE.
          ENDCASE.

          CLEAR ls_att.
          ls_att  = lo_main->generate_attachment(
                            EXPORTING iv_docnum       = <gdoc>-doc_id
                                      iv_doc_category = <gdoc>-doc_cat
                                      iv_key          = lv_key
                            IMPORTING ev_size         = lv_size ).


          IF ls_att-content IS INITIAL OR lv_size <= 0.
            CONTINUE.
          ENDIF.

          DATA(lv_name) = lo_main->build_filename(
                            iv_doc_category = <gdoc>-doc_cat
                            iv_docnum       = <gdoc>-doc_id ).
          DATA(lv_full) = lo_main->build_fullpath(
                            iv_dir  = lv_base_dir
                            iv_name = lv_name ).


          CALL METHOD cl_gui_frontend_services=>gui_download
            EXPORTING
              bin_filesize            = lv_size
              filename                = lv_full
              filetype                = 'BIN'
            CHANGING
              data_tab                = ls_att-content
            EXCEPTIONS
              file_write_error        = 1
              no_batch                = 2
              gui_refuse_filetransfer = 3
              invalid_type            = 4
              no_authority            = 5
              unknown_error           = 6
              header_not_allowed      = 7
              separator_not_allowed   = 8
              filesize_not_allowed    = 9
              header_too_long         = 10
              dp_error_create         = 11
              dp_error_send           = 12
              dp_error_write          = 13
              unknown_dp_error        = 14
              access_denied           = 15
              dp_out_of_memory        = 16
              disk_full               = 17
              dp_timeout              = 18
              file_not_found          = 19
              dataprovider_exception  = 20
              control_flush_error     = 21
              not_supported_by_gui    = 22
              error_no_gui            = 23
              OTHERS                  = 24.
          IF sy-subrc <> 0.

            MESSAGE ID sy-msgid TYPE gc_i  NUMBER sy-msgno DISPLAY LIKE gc_e
                    WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.

          ELSE.
            APPEND lv_full TO lt_path.
          ENDIF.

        ENDLOOP.
        UNASSIGN <gdoc>.

        "
        IF lt_path IS INITIAL.
          CONTINUE.
        ENDIF.

        CREATE OBJECT lr_outlook 'Outlook.Application'.
        CLEAR lr_mail.
        CALL METHOD OF lr_outlook 'CreateItem' = lr_mail
          EXPORTING #1 = 0.
        SET PROPERTY OF lr_mail 'To' = lv_to.
        SET PROPERTY OF lr_mail 'CC' = lv_cc.

        SET PROPERTY OF lr_mail 'Subject' = lv_subject.
        SET PROPERTY OF lr_mail 'Body'    = lv_body_text.
        IF p_sender IS NOT INITIAL.
          SET PROPERTY OF lr_mail 'SentOnBehalfOfName' = p_sender.
        ENDIF.

        CALL METHOD OF lr_mail 'Attachments' = lr_attachments.
        LOOP AT lt_path ASSIGNING FIELD-SYMBOL(<path>).
          CALL METHOD OF lr_attachments 'Add' EXPORTING #1 = <path>.
        ENDLOOP.
        UNASSIGN <path>.

        CALL METHOD OF lr_mail 'Display'.
        FREE OBJECT lr_mail.

      ENDLOOP.
      UNASSIGN <grp>.

      FREE OBJECT lr_outlook.

  ENDCASE.
ENDMODULE.

