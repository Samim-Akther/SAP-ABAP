      SELECT vbeln
        FROM likp
        INTO TABLE @lt_tmp_delivery
        WHERE vbeln IN @s_vbldel
          AND vkorg  = @p_vkorg.
      IF sy-subrc = 0.
        SORT lt_tmp_delivery BY vbeln.
