    IF sy-subrc NE 0.
      CLEAR ld_mess.
      CONCATENATE 'Errore Apertura  file' id_file
      INTO ld_mess SEPARATED by space.
      MESSAGE e002(sy) WITH ld_mess INTO dummy.
      cx_dv_exception=>raise_from_message( ).
    ENDIF.

    DO.
      READ DATASET id_file INTO <fd_line>.
      IF sy-subrc NE 0.
        EXIT.
      ELSE.
        APPEND <fd_line> TO et_dati.
      ENDIF.
    ENDDO.

    CLOSE DATASET id_file.

    IF et_dati[] IS NOT INITIAL.
      CLEAR ld_mess.
      CONCATENATE 'Upload' id_file 'OK' INTO ld_mess SEPARATED BY space.
      MESSAGE s002(sy) WITH ld_mess.
    ENDIF.

  ENDMETHOD.
  METHOD upload_xls_from_pc.

    DATA: lo_dref TYPE REF TO data.
    DATA: lo_lref TYPE REF TO data.

    DATA: ld_cols       TYPE sytabix.
    DATA: ld_begin_row  TYPE sytabix.
    DATA: ld_end_col    TYPE sytabix.
    DATA: lt_tabline    TYPE TABLE OF alsmex_tabline.

    FIELD-SYMBOLS: <lt> TYPE STANDARD TABLE.
    FIELD-SYMBOLS: <ls> TYPE any.
    FIELD-SYMBOLS: <ld> TYPE any.

    CREATE DATA lo_dref TYPE TABLE OF (id_row_type).
    CREATE DATA lo_lref TYPE (id_row_type).

    ASSIGN lo_dref->* TO <lt>.
    ASSIGN lo_lref->* TO <ls>.

    DO.
      UNASSIGN <ld>.
      ASSIGN COMPONENT sy-index OF STRUCTURE <ls> TO <ld>.
      IF sy-subrc NE 0. EXIT. ENDIF.
      ADD 1 TO ld_cols.
    ENDDO.

    IF ld_cols = 0.
      EXIT.
    ENDIF.

    ld_begin_row = SWITCH #( id_header
                                   WHEN abap_false THEN 1
                                   WHEN abap_true  THEN 2 ) .

    CALL FUNCTION 'ALSM_EXCEL_TO_INTERNAL_TABLE'
      EXPORTING
        filename                = id_file
        i_begin_col             = 1
        i_begin_row             = ld_begin_row
        i_end_col               = ld_cols
        i_end_row               = id_rows
*        i_shname                = id_sheet
      TABLES
        intern                  = lt_tabline
      EXCEPTIONS
        inconsistent_parameters = 1
        upload_ole              = 2
        OTHERS                  = 3.

    IF sy-subrc <> 0.
      MESSAGE e777(s3) WITH 'Processing File Error.' INTO dummy.
      cx_dv_exception=>raise_from_message( ).
    ENDIF.

    LOOP AT lt_tabline ASSIGNING FIELD-SYMBOL(<ls_tabline>).
      UNASSIGN <ld>.
      ASSIGN COMPONENT <ls_tabline>-col OF STRUCTURE <ls> TO <ld>.
      IF <ld> IS NOT ASSIGNED.
        CONTINUE.
      ENDIF.

      DATA(ld_type) = cl_abap_datadescr=>get_data_type_kind( <ld> ).
      CASE ld_type.
        WHEN cl_abap_typedescr=>typekind_decfloat
          OR cl_abap_typedescr=>typekind_decfloat16
          OR cl_abap_typedescr=>typekind_decfloat34
          OR cl_abap_typedescr=>typekind_float
          OR cl_abap_typedescr=>typekind_int
          OR cl_abap_typedescr=>typekind_int1
          OR cl_abap_typedescr=>typekind_int2
          OR cl_abap_typedescr=>typekind_packed.

          REPLACE ALL OCCURRENCES OF '.' IN <ls_tabline>-value WITH space.
          REPLACE ALL OCCURRENCES OF ',' IN <ls_tabline>-value WITH '.'.
          CONDENSE <ls_tabline>-value NO-GAPS.
        WHEN cl_abap_typedescr=>typekind_date.

          REPLACE ALL OCCURRENCES OF '/' IN <ls_tabline>-value WITH '.'.
          REPLACE ALL OCCURRENCES OF '-' IN <ls_tabline>-value WITH '.'.
          CALL FUNCTION 'CONVERSION_EXIT_SDATE_INPUT'
            EXPORTING
              input  = <ls_tabline>-value
            IMPORTING
              output = <ls_tabline>-value.
        WHEN cl_abap_typedescr=>typekind_time.
          REPLACE ALL OCCURRENCES OF ':' IN <ls_tabline>-value WITH space.
          CONDENSE <ls_tabline>-value NO-GAPS.
        WHEN OTHERS.
      ENDCASE.

      TRY.
          <ld> = <ls_tabline>-value.
        CATCH cx_sy_conversion_error INTO DATA(exc_conv).
          MESSAGE e777(s3) WITH 'Conversion Error' INTO dummy.
          cx_dv_exception=>raise_from_message( ).
      ENDTRY.

      AT END OF row.
        APPEND <ls> TO <lt>. CLEAR <ls>.
      ENDAT.
    ENDLOOP.

    et_tab = <lt>.

  ENDMETHOD.
  METHOD copy_server_bin.

    DATA lt TYPE STANDARD TABLE OF string.

