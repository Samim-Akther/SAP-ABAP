  METHOD upload_csv_from_server.

    DATA: lo_dref TYPE REF TO data.
    DATA: lo_lref TYPE REF TO data.

    FIELD-SYMBOLS: <lt> TYPE STANDARD TABLE.
    FIELD-SYMBOLS: <ls> TYPE any.
    FIELD-SYMBOLS: <ld> TYPE any.

    CREATE DATA lo_dref TYPE TABLE OF (id_row_type).
    CREATE DATA lo_lref TYPE (id_row_type).

    ASSIGN lo_dref->* TO <lt>.
    ASSIGN lo_lref->* TO <ls>.

    DATA: lt_dbupl      TYPE STANDARD TABLE OF string,
          lt_parts      TYPE STANDARD TABLE OF string,
          lv_comp_index TYPE i.
*--------------------------------------------------------------------*

    TRY.
        CALL METHOD zs4_ivge_cl_gen_file=>upload_server
          EXPORTING
            id_file = id_file
          IMPORTING
            et_dati = lt_dbupl.
      CATCH cx_dv_exception INTO DATA(lo_exc).
        cx_dv_exception=>raise_from_message( ).
    ENDTRY.

    IF id_header = abap_true.
      DELETE lt_dbupl INDEX 1.
    ENDIF.

    "Populating CSV structure
    LOOP AT lt_dbupl INTO DATA(ls_dbupl).
      IF ls_dbupl IS INITIAL.
        CONTINUE.
      ENDIF.

      "Last character CRLF problem
      REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf IN ls_dbupl WITH ''.       "CR_LF
      REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf(1) IN ls_dbupl WITH ''.    "CR
      REPLACE ALL OCCURRENCES OF cl_abap_char_utilities=>cr_lf+1(1) IN ls_dbupl WITH ''.  "LF

      SPLIT ls_dbupl AT id_separator INTO TABLE lt_parts.

      lv_comp_index = 0.
      LOOP AT lt_parts INTO DATA(ls_part).
        lv_comp_index = lv_comp_index + 1.
        IF ls_part IS INITIAL.
          CONTINUE.
        ENDIF.

        ASSIGN COMPONENT lv_comp_index OF STRUCTURE <ls> TO <ld>.
        IF <ld> IS NOT ASSIGNED.
          CONTINUE.
        ENDIF.

        DATA(ld_type) = cl_abap_datadescr=>get_data_type_kind( <ld> ).
        CASE ld_type.
          WHEN cl_abap_typedescr=>typekind_decfloat
            OR cl_abap_typedescr=>typekind_decfloat16
            OR cl_abap_typedescr=>typekind_decfloat34
            OR cl_abap_typedescr=>typekind_float
            OR cl_abap_typedescr=>typekind_int
            OR cl_abap_typedescr=>typekind_int1
            OR cl_abap_typedescr=>typekind_int2
            OR cl_abap_typedescr=>typekind_packed.

            REPLACE ALL OCCURRENCES OF '.' IN ls_part WITH space.
            REPLACE ALL OCCURRENCES OF ',' IN ls_part WITH '.'.
            CONDENSE ls_part NO-GAPS.
          WHEN cl_abap_typedescr=>typekind_date.

            REPLACE ALL OCCURRENCES OF '/' IN ls_part WITH '.'.
            REPLACE ALL OCCURRENCES OF '-' IN ls_part WITH '.'.
            CALL FUNCTION 'CONVERSION_EXIT_SDATE_INPUT'
              EXPORTING
                input  = ls_part
              IMPORTING
                output = ls_part.
          WHEN cl_abap_typedescr=>typekind_time.
            REPLACE ALL OCCURRENCES OF ':' IN ls_part WITH space.
            CONDENSE ls_part NO-GAPS.
          WHEN OTHERS.
        ENDCASE.

        TRY.
            <ld> = ls_part.
          CATCH cx_sy_conversion_error INTO DATA(exc_conv).
            MESSAGE e777(s3) WITH 'Conversion Error' INTO dummy.
            cx_dv_exception=>raise_from_message( ).
        ENDTRY.

      ENDLOOP.

      APPEND <ls> TO <lt>. CLEAR <ls>.
    ENDLOOP.

    et_dati = <lt>.

  ENDMETHOD.


