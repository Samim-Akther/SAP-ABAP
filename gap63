  METHOD copy_pc_to_server.

    DATA: ld_mess TYPE char100.
    DATA: lt_dati TYPE STANDARD TABLE OF string.

    TRY.
        CALL METHOD ZS4_IVGE_CL_GEN_FILE=>upload_pc
          EXPORTING
            id_file = id_source
            id_type = 'BIN'
          IMPORTING
            et_dati = lt_dati.
      CATCH cx_dv_exception INTO DATA(exc).
        RAISE upload_file_error.
    ENDTRY.

    TRY.
        CALL METHOD ZS4_IVGE_CL_GEN_FILE=>download_server_bin(
          EXPORTING
            id_file = id_dest
            it_dati = lt_dati ).
      CATCH cx_dv_exception INTO exc.
        RAISE download_file_error.
    ENDTRY.

    CONCATENATE 'Copia' 'file' 'OK' INTO ld_mess SEPARATED BY space .
    MESSAGE s002(sy) WITH ld_mess.


  ENDMETHOD.


  METHOD copy_server.

    DATA lt TYPE STANDARD TABLE OF string.

    TRY.
        ZS4_IVGE_CL_GEN_FILE=>upload_server(
          EXPORTING
            id_file = id_file_src
          IMPORTING
            et_dati = lt[] ).
      CATCH cx_dv_exception INTO DATA(lo_exc).
        cx_dv_exception=>raise_from_message( ).
    ENDTRY.

    TRY.
        ZS4_IVGE_CL_GEN_FILE=>download_server(
          EXPORTING
            id_file = id_file_dest
            it_dati = lt[] ).
      CATCH cx_dv_exception INTO lo_exc.
        cx_dv_exception=>raise_from_message( ).
    ENDTRY.

    IF id_source_delete = abap_true.
      DELETE DATASET id_file_src.
    ENDIF.

  ENDMETHOD.

