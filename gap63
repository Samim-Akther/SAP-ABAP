  METHOD download_server.

    DATA: ld_mess      TYPE symsgv.
    DATA: lo_ref_line  TYPE REF TO data.

    FIELD-SYMBOLS: <fd_line> TYPE any.

    CREATE DATA lo_ref_line TYPE string.
    ASSIGN lo_ref_line->* TO <fd_line>.

    CASE id_appending.
      WHEN abap_false.
        OPEN DATASET id_file FOR OUTPUT IN TEXT MODE ENCODING DEFAULT.
      WHEN abap_true.
        OPEN DATASET id_file FOR APPENDING IN TEXT MODE ENCODING DEFAULT.
    ENDCASE.
    IF sy-subrc NE 0.
      CONCATENATE 'Errore Apertura id_file' id_file
             INTO ld_mess SEPARATED BY space.
      MESSAGE e002(sy) WITH ld_mess INTO dummy.
      cx_dv_exception=>raise_from_message( ).
    ENDIF.

    LOOP AT it_dati ASSIGNING <fd_line>.
      IF id_lenght IS NOT INITIAL.
        IF id_no_end = abap_true.
          TRANSFER <fd_line> TO id_file LENGTH id_lenght NO END OF LINE.
        ELSE.
          TRANSFER <fd_line> TO id_file LENGTH id_lenght.
        ENDIF.
      ELSE.
        IF id_no_end = abap_true.
          TRANSFER <fd_line> TO id_file NO END OF LINE.
        ELSE.
          TRANSFER <fd_line> TO id_file.
        ENDIF.
      ENDIF.
    ENDLOOP.

    CLOSE DATASET id_file.
    IF sy-subrc = 0.
      CONCATENATE 'Download' id_file 'OK' INTO ld_mess SEPARATED BY space.
      MESSAGE s002(sy) WITH ld_mess INTO dummy.
    ELSE.
      CONCATENATE 'Errore Apertura id_file' id_file
             INTO ld_mess SEPARATED BY space.
      MESSAGE e002(sy) WITH ld_mess INTO dummy.
      cx_dv_exception=>raise_from_message( ).
    ENDIF.

  ENDMETHOD.

  METHOD download_server_bin.

    DATA: ld_mess      TYPE symsgv.
    DATA: lo_ref_line  TYPE REF TO data.

    FIELD-SYMBOLS: <fd_line> TYPE any.

    CREATE DATA lo_ref_line TYPE string.
    ASSIGN lo_ref_line->* TO <fd_line>.

    CASE id_appending.
      WHEN abap_false.
        OPEN DATASET id_file FOR OUTPUT IN BINARY MODE.
      WHEN abap_true.
