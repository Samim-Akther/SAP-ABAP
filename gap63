    IF iv_non_unicode EQ 'X'.
      OPEN DATASET id_file FOR INPUT IN TEXT MODE ENCODING NON-UNICODE.
    ELSE.
      OPEN DATASET id_file FOR INPUT IN TEXT MODE ENCODING DEFAULT.
