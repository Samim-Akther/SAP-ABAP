  METHOD download_server_zip.

    DATA: ld_mess       TYPE symsgv.
    DATA: lo_ref_line   TYPE REF TO data.
    DATA: lt_file_tab   TYPE STANDARD TABLE OF solisti1.
    DATA: ld_bytecount  TYPE i.
    DATA: ld_content_x  TYPE xstring.
    DATA: ld_zip        TYPE xstring.
    DATA: lo_zipper     TYPE REF TO cl_abap_zip.

    FIELD-SYMBOLS: <fd_line> TYPE any.

    CREATE DATA lo_ref_line TYPE string.
    ASSIGN lo_ref_line->* TO <fd_line>.

    CALL FUNCTION 'SX_TABLE_LINE_WIDTH_CHANGE'
      EXPORTING
        line_width_src = 134
        line_width_dst = 255
      TABLES
        content_in     = it_dati
        content_out    = lt_file_tab.

    ld_bytecount = id_size.
    CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
      EXPORTING
        input_length = ld_bytecount
      IMPORTING
        buffer       = ld_content_x
      TABLES
        binary_tab   = lt_file_tab[].

    "create our zipper object
    CREATE OBJECT lo_zipper.

    "add file to zip
    lo_zipper->add(
      EXPORTING
        name    = id_file_zip
        content = ld_content_x ).

    "save zip
    ld_zip = lo_zipper->save( ).

    CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
      EXPORTING
        buffer        = ld_zip
      IMPORTING
        output_length = ld_bytecount
      TABLES
        binary_tab    = lt_file_tab.

    ZS4_IVGE_CL_GEN_FILE=>download_server_bin(
        id_file      = id_file_zip
        it_dati      = lt_file_tab
        id_appending = id_appending ).


  ENDMETHOD.
